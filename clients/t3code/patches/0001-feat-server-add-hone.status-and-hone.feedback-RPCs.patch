@@ -0,0 +1,45 @@
+import * as Schema from "effect/Schema";
+import { NonNegativeInt, ThreadId, TrimmedString } from "./baseSchemas.ts";
+
+/** What the Hone service reports about the AGENTS.md the agent runs and the next optimization. */
+export const HoneStatus = Schema.Struct({
+  reachable: Schema.Boolean,
+  dashboardUrl: Schema.NullOr(Schema.String),
+  versionId: Schema.NullOr(Schema.String),
+  versionTitle: Schema.NullOr(Schema.String),
+  branch: Schema.NullOr(Schema.String),
+  traceCount: NonNegativeInt,
+  /** Sessions Hone has not yet optimized from. */
+  pendingCount: NonNegativeInt,
+  batchSize: NonNegativeInt,
+  run: Schema.NullOr(Schema.Struct({ id: Schema.String, status: Schema.String })),
+});
+export type HoneStatus = typeof HoneStatus.Type;
+
+export const HoneFeedbackRating = Schema.Literals(["up", "down"]);
+export type HoneFeedbackRating = typeof HoneFeedbackRating.Type;
+
+export const HoneFeedbackInput = Schema.Struct({
+  threadId: ThreadId,
+  rating: Schema.NullOr(HoneFeedbackRating),
+  comment: TrimmedString,
+});
+export type HoneFeedbackInput = typeof HoneFeedbackInput.Type;
+
+export const HoneFeedbackResult = Schema.Struct({
+  traceId: Schema.String,
+});
+export type HoneFeedbackResult = typeof HoneFeedbackResult.Type;
+
+export const HoneErrorReason = Schema.Literals([
+  "unreachable",
+  "not-published",
+  "no-pi-session",
+  "rejected",
+]);
+export type HoneErrorReason = typeof HoneErrorReason.Type;
+
+export class HoneError extends Schema.TaggedError<HoneError>()("HoneError", {
+  reason: HoneErrorReason,
+  message: Schema.String,
+}) {}
