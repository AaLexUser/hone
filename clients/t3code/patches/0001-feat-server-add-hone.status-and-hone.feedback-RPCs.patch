diff --git a/apps/server/src/hone/Hone.test.ts b/apps/server/src/hone/Hone.test.ts
new file mode 100644
index 00000000..5584c3a9
--- /dev/null
+++ b/apps/server/src/hone/Hone.test.ts
@@ -0,0 +1,39 @@
+import { describe, expect, it } from "@effect/vitest";
+
+import { honeFeedbackText, honeTraceId, piSessionIdOf } from "./Hone.ts";
+
+describe("honeTraceId", () => {
+  it("matches the id Hone gives a Pi session", () => {
+    expect(honeTraceId("01A19D0C-7f2e-4b1a-9c3d-123456789abc")).toBe("ses_01a19d0c");
+  });
+});
+
+describe("piSessionIdOf", () => {
+  it("reads the session header line", () => {
+    const contents =
+      '\n{"type":"session","id":"01a19d0c-aaaa-bbbb-cccc-dddddddddddd"}\n{"type":"x"}';
+    expect(piSessionIdOf("/s/whatever.jsonl", contents)).toBe(
+      "01a19d0c-aaaa-bbbb-cccc-dddddddddddd",
+    );
+  });
+
+  it("falls back to the uuid in the file name", () => {
+    expect(piSessionIdOf("/s/2026_01a19d0c-aaaa-bbbb-cccc-dddddddddddd.jsonl", "not json")).toBe(
+      "01a19d0c-aaaa-bbbb-cccc-dddddddddddd",
+    );
+  });
+});
+
+describe("honeFeedbackText", () => {
+  it("prefixes the rating", () => {
+    expect(honeFeedbackText({ rating: "down", comment: " Use long dates " })).toBe(
+      "👎 Use long dates",
+    );
+    expect(honeFeedbackText({ rating: "up", comment: "" })).toBe("👍");
+    expect(honeFeedbackText({ rating: null, comment: "Shorter" })).toBe("Shorter");
+  });
+
+  it("has nothing to send without a rating or comment", () => {
+    expect(honeFeedbackText({ rating: null, comment: "  " })).toBeNull();
+  });
+});
diff --git a/apps/server/src/hone/Hone.ts b/apps/server/src/hone/Hone.ts
new file mode 100644
index 00000000..c59df5d1
--- /dev/null
+++ b/apps/server/src/hone/Hone.ts
@@ -0,0 +1,193 @@
+import {
+  HoneError,
+  type HoneFeedbackInput,
+  type HoneFeedbackResult,
+  type HoneStatus,
+} from "@t3tools/contracts";
+import * as Config from "effect/Config";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Option from "effect/Option";
+import * as Schema from "effect/Schema";
+import { HttpClient, HttpClientRequest } from "effect/http";
+
+import * as ThreadManagementService from "../orchestration-v2/ThreadManagementService.ts";
+
+const HoneConfig = Config.all({
+  url: Config.String("HONE_URL").pipe(Config.option),
+  token: Config.Redacted("HONE_TOKEN").pipe(Config.option),
+  dashboardUrl: Config.String("HONE_DASHBOARD_URL").pipe(Config.option),
+});
+
+const HoneState = Schema.Struct({
+  traces: Schema.Array(Schema.Struct({ status: Schema.String })),
+  versions: Schema.Array(
+    Schema.Struct({ id: Schema.String, title: Schema.NullishOr(Schema.String) }),
+  ),
+  currentId: Schema.NullishOr(Schema.String),
+  currentBranch: Schema.NullishOr(Schema.String),
+  batchSize: Schema.Int,
+  run: Schema.NullishOr(Schema.Struct({ id: Schema.String, status: Schema.String })),
+});
+
+const PiSessionHeader = Schema.fromJsonString(
+  Schema.Struct({ type: Schema.Literal("session"), id: Schema.String }),
+);
+const decodePiSessionHeader = Schema.decodeUnknownOption(PiSessionHeader);
+const isHoneError = Schema.is(HoneError);
+
+const UUID_PATTERN = /[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/i;
+
+const readConfig = Effect.orDie(HoneConfig);
+
+const baseUrl = (url: string) => url.replace(/\/+$/, "");
+
+function unreachableStatus(dashboardUrl: string | null): HoneStatus {
+  return {
+    reachable: false,
+    dashboardUrl,
+    versionId: null,
+    versionTitle: null,
+    branch: null,
+    traceCount: 0,
+    pendingCount: 0,
+    batchSize: 0,
+    run: null,
+  };
+}
+
+export const honeStatus = Effect.gen(function* () {
+  const config = yield* readConfig;
+  if (Option.isNone(config.url)) return unreachableStatus(null);
+  const url = baseUrl(config.url.value);
+  const dashboardUrl = Option.getOrElse(config.dashboardUrl, () => url);
+  const http = yield* HttpClient.HttpClient;
+  return yield* http.execute(HttpClientRequest.get(`${url}/api/state`)).pipe(
+    Effect.flatMap((response) => response.json),
+    Effect.flatMap(Schema.decodeUnknownEffect(HoneState)),
+    Effect.map((state): HoneStatus => {
+      const current = state.versions.find((version) => version.id === state.currentId);
+      return {
+        reachable: true,
+        dashboardUrl,
+        versionId: state.currentId ?? null,
+        versionTitle: current?.title ?? null,
+        branch: state.currentBranch ?? null,
+        traceCount: state.traces.length,
+        pendingCount: state.traces.filter((trace) => trace.status === "new").length,
+        batchSize: state.batchSize,
+        run: state.run ?? null,
+      };
+    }),
+    Effect.timeout("3 seconds"),
+    Effect.orElseSucceed(() => unreachableStatus(dashboardUrl)),
+  );
+}).pipe(Effect.withSpan("hone.status"));
+
+/** Mirrors Hone's trace id derivation (hone/ids.py) for a Pi session id. */
+export function honeTraceId(piSessionId: string): string {
+  return `ses_${piSessionId
+    .replace(/[^0-9a-f]/gi, "")
+    .slice(0, 8)
+    .toLowerCase()}`;
+}
+
+/** The line the optimizer reads; null when there is nothing to send. */
+export function honeFeedbackText(input: Pick<HoneFeedbackInput, "rating" | "comment">) {
+  const comment = input.comment.trim();
+  const mark = input.rating === "up" ? "👍" : input.rating === "down" ? "👎" : null;
+  if (mark === null) return comment === "" ? null : comment;
+  return comment === "" ? mark : `${mark} ${comment}`;
+}
+
+/** Pi names the session in its file's header line, as Hone's Pi extension reads it. */
+export function piSessionIdOf(sessionFile: string, contents: string): string | null {
+  for (const line of contents.split("\n")) {
+    if (line.trim() === "") continue;
+    const header = decodePiSessionHeader(line);
+    if (Option.isSome(header)) return header.value.id;
+  }
+  return sessionFile.split(/[\\/]/).at(-1)?.match(UUID_PATTERN)?.[0] ?? null;
+}
+
+export const honeFeedback = Effect.fn("hone.feedback")(
+  function* (input: HoneFeedbackInput) {
+    const text = honeFeedbackText(input);
+    if (text === null) {
+      return yield* new HoneError({ reason: "rejected", message: "Add a rating or a comment." });
+    }
+    const config = yield* readConfig;
+    if (Option.isNone(config.url)) {
+      return yield* new HoneError({ reason: "unreachable", message: "HONE_URL is not set." });
+    }
+    // Read from the stored projection so feedback still works after Pi's process exits.
+    const threadManagement = yield* ThreadManagementService.ThreadManagementService;
+    const projection = yield* threadManagement.getThreadRecords(input.threadId, [
+      "providerThreads",
+    ]);
+    const piThreads = projection.providerThreads.filter((thread) => thread.driver === "pi");
+    const piThread =
+      piThreads.find((thread) => thread.id === projection.thread.activeProviderThreadId) ??
+      piThreads.at(-1);
+    const sessionFile = piThread?.nativeThreadRef?.nativeId ?? null;
+    if (sessionFile === null) {
+      return yield* new HoneError({
+        reason: "no-pi-session",
+        message: "This thread has no Pi session yet.",
+      });
+    }
+    const fileSystem = yield* FileSystem.FileSystem;
+    const contents = yield* fileSystem
+      .readFileString(sessionFile)
+      .pipe(Effect.orElseSucceed(() => ""));
+    const sessionId = piSessionIdOf(sessionFile, contents);
+    if (sessionId === null) {
+      return yield* new HoneError({
+        reason: "no-pi-session",
+        message: "Could not read the Pi session id.",
+      });
+    }
+    const traceId = honeTraceId(sessionId);
+    const http = yield* HttpClient.HttpClient;
+    const request = HttpClientRequest.post(
+      `${baseUrl(config.url.value)}/api/traces/${traceId}/feedback`,
+    ).pipe(
+      Option.isSome(config.token)
+        ? HttpClientRequest.bearerToken(config.token.value)
+        : (request) => request,
+      HttpClientRequest.bodyJsonUnsafe({ text }),
+    );
+    const response = yield* http.execute(request).pipe(
+      Effect.timeout("5 seconds"),
+      Effect.mapError(
+        () => new HoneError({ reason: "unreachable", message: "Could not reach Hone." }),
+      ),
+    );
+    if (response.status === 404) {
+      return yield* new HoneError({
+        reason: "not-published",
+        message: "Hone has not received this session yet. Try again after the reply finishes.",
+      });
+    }
+    if (response.status < 200 || response.status >= 300) {
+      return yield* new HoneError({
+        reason: "rejected",
+        message: `Hone rejected the feedback (HTTP ${response.status}).`,
+      });
+    }
+    return { traceId } satisfies HoneFeedbackResult;
+  },
+  (effect) =>
+    effect.pipe(
+      Effect.catchIf(
+        (error) => !isHoneError(error),
+        (error) =>
+          Effect.fail(
+            new HoneError({
+              reason: "no-pi-session",
+              message: `Could not load the thread: ${error.message}`,
+            }),
+          ),
+      ),
+    ),
+);
