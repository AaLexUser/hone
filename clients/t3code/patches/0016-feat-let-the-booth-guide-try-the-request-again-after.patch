   });
 });
+
+describe("wouldReplay", () => {
+  it("finds a recording only while the project still produces its key", () => {
+    const root = NodeFS.mkdtempSync(NodePath.join(NodeOS.tmpdir(), "hone-pi-retry-"));
+    const project = NodePath.join(root, "project");
+    const cache = NodePath.join(root, "cache");
+    NodeFS.mkdirSync(project);
+    NodeFS.mkdirSync(cache);
+    NodeFS.writeFileSync(NodePath.join(project, "AGENTS.md"), "Leave out a £0 bonus.");
+    NodeFS.writeFileSync(NodePath.join(project, "Offer.pdf"), "first letter");
+    const prompt = "Prepare the letter.";
+    const model = { provider: "p", modelId: "m" };
+    const key = turnKey({
+      message: prompt,
+      images: [],
+      model,
+      thinkingLevel: "high",
+      cwd: project,
+    });
+    NodeFS.writeFileSync(
+      NodePath.join(cache, `${key}.json`),
+      JSON.stringify({
+        version: TURN_RECORDING_VERSION,
+        key,
+        recordedAt: "2026-11-12T00:00:00.000Z",
+        source: { sessionId: "s", sessionFile: "f", cwd: project, model, thinkingLevel: "high" },
+        prompt,
+        attachments: [],
+        events: [],
+        files: [],
+        session: "",
+      }),
+    );
+    const check = (input: { prompt?: string; model?: typeof model | null }) =>
+      wouldReplay({
+        dirs: [NodePath.join(root, "missing"), cache],
+        cwd: project,
+        prompt: input.prompt ?? prompt,
+        model: input.model === undefined ? model : input.model,
+      });
+
+    expect(check({})).toBe(true);
+    expect(check({ prompt: " Prepare  the letter. " })).toBe(true);
+    expect(check({ model: null })).toBe(true);
+    expect(check({ prompt: "Prepare another letter." })).toBe(false);
+    expect(check({ model: { provider: "p", modelId: "other" } })).toBe(false);
+    // Rewriting a letter keeps the key, a new AGENTS.md or a new file name does not.
+    NodeFS.writeFileSync(NodePath.join(project, "Offer.pdf"), "second letter");
+    expect(check({})).toBe(true);
+    NodeFS.writeFileSync(NodePath.join(project, "AGENTS.md"), "Older rules.");
+    expect(check({})).toBe(false);
+    // Pi's Hone extension writes the current AGENTS.md when the chat starts.
+    expect(
+      wouldReplay({
+        dirs: [cache],
+        cwd: project,
+        prompt,
+        model,
+        agentsMd: "Leave out a £0 bonus.",
+      }),
+    ).toBe(true);
+    NodeFS.writeFileSync(NodePath.join(project, "AGENTS.md"), "Leave out a £0 bonus.");
+    NodeFS.writeFileSync(NodePath.join(project, "Other.pdf"), "x");
+    expect(check({})).toBe(false);
+    NodeFS.rmSync(root, { recursive: true, force: true });
+  });
+});
