+  const guideRetry = Effect.fn("HoneDemo.guideRetry")(
+    function* (input: HoneGuideRetryInput) {
+      const config = yield* readHoneConfig;
+      if (!config.demo) return { available: false };
+      // A recording visit sends the request to the model and keeps the turn.
+      if (config.turnCacheRecord) return { available: true };
+      const cwd = yield* projectFolder;
+      const [provider, ...modelId] = config.demoModel.split("/");
+      const model =
+        config.demoModel === "default" || provider === undefined || modelId.length === 0
+          ? null
+          : { provider, modelId: modelId.join("/") };
+      // Hone's Pi extension writes the current AGENTS.md into the folder when the chat's Pi
+      // starts, so the check reads it from Hone. Offline, Pi keeps the file on disk.
+      const agentsMd = Option.isNone(config.url)
+        ? null
+        : yield* http
+            .execute(
+              HttpClientRequest.get(`${honeBaseUrl(config.url.value)}/agents.md`).pipe(
+                Option.isSome(config.token)
+                  ? HttpClientRequest.bearerToken(config.token.value)
+                  : (request) => request,
+              ),
+            )
+            .pipe(
+              Effect.flatMap((response) =>
+                response.status === 200 ? response.text : Effect.succeed(null),
+              ),
+              Effect.timeout("3 seconds"),
+              Effect.orElseSucceed(() => null),
+            );
+      const dirs = turnCacheDirs(config.turnCacheDir);
+      const available = yield* Effect.sync(() =>
+        wouldReplay({
+          dirs,
+          cwd,
+          prompt: input.prompt,
+          model,
+          ...(agentsMd === null ? {} : { agentsMd }),
+        }),
+      );
+      return { available } satisfies HoneGuideRetryResult;
+    },
+    Effect.orElseSucceed(() => ({ available: false }) satisfies HoneGuideRetryResult),
+  );
+
+  return { reset, resetAtStartup, guideRetry } satisfies HoneDemo["Service"];
 });
 
 export const layer = Layer.effect(HoneDemo, make).pipe(Layer.provide(FetchHttpClient.layer));
