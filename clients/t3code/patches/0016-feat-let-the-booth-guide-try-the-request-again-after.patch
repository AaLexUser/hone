     JSON.stringify({
@@ -236,3 +245,53 @@ export function changedFiles(
   }
   return changed;
 }
+
+/** The directories `HONE_TURN_CACHE_DIR` names, the first one being where new recordings go. */
+export function turnCacheDirs(value: string | undefined): string[] {
+  return (value ?? "").split(NodePath.delimiter).filter(Boolean);
+}
+
+/**
+ * Whether a new chat in `cwd` whose first prompt is `prompt` would replay a recording now. It
+ * looks for a recording of that prompt, on `model` when one is given, whose key the project
+ * folder still produces with the recorded model and thinking level.
+ */
+export function wouldReplay(input: {
+  readonly dirs: ReadonlyArray<string>;
+  readonly cwd: string;
+  readonly prompt: string;
+  readonly model: PiModelChoice | null;
+  readonly agentsMd?: string;
+}): boolean {
+  const prompt = normalizePrompt(input.prompt);
+  for (const dir of input.dirs) {
+    let names: string[];
+    try {
+      names = NodeFS.readdirSync(dir).filter((name) => name.endsWith(".json"));
+    } catch {
+      continue;
+    }
+    for (const name of names) {
+      const recording = readRecording(dir, name.slice(0, -".json".length));
+      if (recording === null || recording.attachments.length > 0) continue;
+      if (normalizePrompt(recording.prompt) !== prompt) continue;
+      const model = recording.source.model;
+      if (
+        input.model !== null &&
+        (model?.provider !== input.model.provider || model.modelId !== input.model.modelId)
+      ) {
+        continue;
+      }
+      const keys = turnKeys({
+        message: recording.prompt,
+        images: [],
+        model,
+        thinkingLevel: recording.source.thinkingLevel,
+        cwd: input.cwd,
+        ...(input.agentsMd === undefined ? {} : { agentsMd: input.agentsMd }),
+      });
+      if (keys.includes(recording.key)) return true;
+    }
+  }
+  return false;
+}
