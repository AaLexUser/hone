-/** The line the optimizer reads; null when there is nothing to send. */
-export function honeFeedbackText(input: Pick<HoneFeedbackInput, "rating" | "comment">) {
-  const comment = input.comment.trim();
-  const mark = input.rating === "up" ? "👍" : input.rating === "down" ? "👎" : null;
-  if (mark === null) return comment === "" ? null : comment;
+const RATING_MARKS: Record<HoneFeedbackRating, string> = { up: "👍", down: "👎" };
+
+/** The text Hone stores and the optimizer reads; null when there is nothing to send. */
+export function honeFeedbackText(feedback: HoneFeedback) {
+  const comment = feedback.comment.trim();
+  if (feedback.rating === null) return comment === "" ? null : comment;
+  const mark = RATING_MARKS[feedback.rating];
   return comment === "" ? mark : `${mark} ${comment}`;
 }
 
+/** Reads Hone's stored feedback back, the inverse of honeFeedbackText. */
+export function parseHoneFeedback(text: string | null | undefined): HoneFeedback | null {
+  const stored = (text ?? "").trim();
+  if (stored === "") return null;
+  const rating: HoneFeedbackRating | null = stored.startsWith(RATING_MARKS.up)
+    ? "up"
+    : stored.startsWith(RATING_MARKS.down)
+      ? "down"
+      : null;
+  const comment = rating === null ? stored : stored.slice(RATING_MARKS[rating].length).trim();
+  return { rating, comment };
+}
