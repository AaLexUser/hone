+  entry,
+  sending,
+  onSave,
+  onRemove,
+}: {
+  readonly entry: HoneFeedbackEntry;
+  readonly sending: boolean;
+  readonly onSave: (edited: HoneFeedbackEntry) => Promise<void>;
+  readonly onRemove: () => Promise<void>;
+}) {
+  const [draft, setDraft] = useState(entry.comment);
+  const changed = draft.trim() !== entry.comment;
+  const save = () => {
+    if (changed) void onSave({ rating: entry.rating, comment: draft.trim() });
+  };
+  return (
+    <div className="flex flex-col gap-1.5">
+      <div className="flex items-start gap-2">
+        <span className="mt-2.5 flex text-muted-foreground">
+          <RatingIcon rating={entry.rating} />
+        </span>
+        <Textarea
+          size="sm"
+          rows={1}
+          value={draft}
+          aria-label="Feedback entry"
+          className="[&_textarea]:min-h-0"
+          onChange={(event) => setDraft(event.target.value)}
+          onKeyDown={(event) => {
+            if (event.key === "Enter" && (event.metaKey || event.ctrlKey)) {
+              event.preventDefault();
+              save();
+            }
+          }}
+        />
+        <Button
+          type="button"
+          size="icon-xs"
+          variant="ghost"
+          className="mt-1 shrink-0"
+          aria-label="Remove this feedback"
+          disabled={sending}
+          onClick={() => void onRemove()}
+        >
+          <Trash2Icon className="size-3" />
+        </Button>
+      </div>
+      {changed ? (
+        <div className="flex justify-end gap-1.5">
+          <Button type="button" size="xs" variant="ghost" onClick={() => setDraft(entry.comment)}>
+            Cancel
+          </Button>
+          <Button type="button" size="xs" disabled={sending} onClick={save}>
+            Save
+          </Button>
+        </div>
       ) : null}
     </div>
   );
