+export function honeFeedbackText(entry: HoneFeedbackEntry) {
+  // Hone stores one entry per line, so a multi-line comment must not split into several entries.
+  const comment = entry.comment.replace(/\s*[\r\n]+\s*/g, " ").trim();
+  if (entry.rating === null) return comment === "" ? null : comment;
+  const mark = RATING_MARKS[entry.rating];
   return comment === "" ? mark : `${mark} ${comment}`;
 }
 
+/** Reads Hone's stored feedback back into entries, the inverse of honeFeedbackText. */
+export function parseHoneFeedback(text: string | null | undefined): HoneFeedbackEntry[] {
+  return (text ?? "")
+    .split("\n")
+    .map((line) => line.trim())
+    .filter((line) => line !== "")
+    .map((line) => {
+      const rating: HoneFeedbackRating | null = line.startsWith(RATING_MARKS.up)
+        ? "up"
+        : line.startsWith(RATING_MARKS.down)
+          ? "down"
+          : null;
+      const comment = rating === null ? line : line.slice(RATING_MARKS[rating].length).trim();
+      return { rating, comment };
+    });
+}
