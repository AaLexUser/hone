+describe("parseHoneFeedback", () => {
+  it("reads the thumb and keeps the whole comment", () => {
+    expect(parseHoneFeedback("👎 Use long dates\n\nAnd keep the bold\n")).toEqual({
+      rating: "down",
+      comment: "Use long dates\n\nAnd keep the bold",
+    });
+    expect(parseHoneFeedback("👍")).toEqual({ rating: "up", comment: "" });
+    expect(parseHoneFeedback("Write dates in full")).toEqual({
+      rating: null,
+      comment: "Write dates in full",
+    });
+  });
