       />
-      <p className="pointer-events-none absolute inset-x-0 bottom-8 text-center text-sm text-white/80">
-        {guideText.videoHint}
+      <p className="pointer-events-none absolute inset-x-0 bottom-8 text-center">
+        <span className="rounded-full bg-black/60 px-4 py-2 text-sm text-white">
+          {guideText.videoHint}
+        </span>
       </p>
-      <span
+      <div
         aria-hidden
+        data-guide-hold={hold ?? undefined}
         className={cn(
-          "absolute inset-x-0 bottom-0 h-1 bg-white",
-          holding ? "w-full transition-[width] ease-linear" : "w-0",
+          "pointer-events-none absolute inset-0 flex flex-col items-center justify-center gap-3 transition-opacity duration-200",
+          hold ? "opacity-100" : "opacity-0",
         )}
-        style={holding ? { transitionDuration: `${VIDEO_DISMISS_HOLD_MS}ms` } : undefined}
-      />
+      >
+        <svg width={112} height={112} viewBox="0 0 112 112" className="-rotate-90 drop-shadow-lg">
+          <circle
+            cx={56}
+            cy={56}
+            r={RING_RADIUS}
+            className="fill-black/85 stroke-white/30"
+            strokeWidth={6}
+          />
+          <circle
+            cx={56}
+            cy={56}
+            r={RING_RADIUS}
+            fill="none"
+            className="stroke-white"
+            strokeWidth={6}
+            strokeLinecap="round"
+            strokeDasharray={RING_LENGTH}
+            strokeDashoffset={hold === "filling" ? 0 : RING_LENGTH}
+            style={
+              hold === "filling"
+                ? { transition: `stroke-dashoffset ${VIDEO_HOLD_MS}ms linear` }
+                : undefined
+            }
+          />
+        </svg>
+        <span className="rounded-full bg-black/70 px-4 py-1.5 text-base text-white">
+          {guideText.videoHold}
+        </span>
+      </div>
     </div>
   );
 }
