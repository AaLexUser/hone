-const VIDEO_DISMISS_HOLD_MS = 2000;
+/** How long a press or a key is held to end the booth video. */
+const VIDEO_HOLD_MS = 1500;
+/** A video that has not started by then closes, so a stalled load cannot hide the app. */
+const VIDEO_START_TIMEOUT_MS = 10_000;
+const RING_RADIUS = 7;
+const RING_LENGTH = 2 * Math.PI * RING_RADIUS;
 
+/**
+ * The booth video fades in over the app once its first frame plays, so the screen never flashes
+ * black while it loads. A tap, a move or a key press does not end it. Only a press or a key held
+ * for VIDEO_HOLD_MS does. The hint at the bottom has a small ring that fills while the visitor
+ * holds, and its text says to keep holding.
+ */
 function BoothVideo({ src, onDismiss }: { readonly src: string; readonly onDismiss: () => void }) {
+  const [shown, setShown] = useState(false);
   const [holding, setHolding] = useState(false);
+  const overlay = useRef<HTMLDivElement>(null);
   const timer = useRef<number | null>(null);
-  const cancelHold = () => {
-    if (timer.current !== null) window.clearTimeout(timer.current);
-    timer.current = null;
-    setHolding(false);
-  };
+  const dismiss = useRef(onDismiss);
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- the timers below call the latest dismiss without restarting
+  useEffect(() => {
+    dismiss.current = onDismiss;
+  });
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- takes focus, so keys held to end the video do not type into the chat below
+  useEffect(() => {
+    overlay.current?.focus();
+    return () => {
+      if (timer.current !== null) window.clearTimeout(timer.current);
+    };
+  }, []);
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- closes a video that never starts, since the overlay holds the screen meanwhile
+  useEffect(() => {
+    if (shown) return;
+    const giveUp = window.setTimeout(() => dismiss.current(), VIDEO_START_TIMEOUT_MS);
+    return () => window.clearTimeout(giveUp);
+  }, [shown]);
+
   const startHold = () => {
-    cancelHold();
+    if (!shown || timer.current !== null) return;
     setHolding(true);
     timer.current = window.setTimeout(() => {
       timer.current = null;
-      onDismiss();
-    }, VIDEO_DISMISS_HOLD_MS);
+      dismiss.current();
+    }, VIDEO_HOLD_MS);
+  };
+  const cancelHold = () => {
+    if (timer.current === null) return;
+    window.clearTimeout(timer.current);
+    timer.current = null;
+    setHolding(false);
+  };
+  const onKey = (event: KeyboardEvent<HTMLDivElement>) => {
+    event.preventDefault();
+    event.stopPropagation();
+    if (event.type === "keyup") cancelHold();
+    else if (!event.repeat) startHold();
   };
+
   return (
     <div
+      ref={overlay}
