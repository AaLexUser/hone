+        >
+          <svg aria-hidden width={18} height={18} viewBox="0 0 18 18" className="-rotate-90">
+            <circle
+              cx={9}
+              cy={9}
+              r={RING_RADIUS}
+              fill="none"
+              className="stroke-white/30"
+              strokeWidth={2.5}
+            />
+            <circle
+              cx={9}
+              cy={9}
+              r={RING_RADIUS}
+              fill="none"
+              className="stroke-primary"
+              strokeWidth={2.5}
+              strokeLinecap="round"
