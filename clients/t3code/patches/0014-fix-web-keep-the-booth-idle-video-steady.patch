       onPointerLeave={cancelHold}
       onPointerCancel={cancelHold}
+      onKeyDown={onKey}
+      onKeyUp={onKey}
     >
       <video
         src={src}
@@ -513,19 +574,51 @@ function BoothVideo({ src, onDismiss }: { readonly src: string; readonly onDismi
         loop
         playsInline
         className="size-full object-contain"
+        onPlaying={() => setShown(true)}
