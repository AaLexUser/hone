From 702892cfe25ad2d2763ce15920d9caed3cc37982 Mon Sep 17 00:00:00 2001
From: build <build@localhost>
Date: Thu, 12 Nov 2026 16:40:49 +0300
Subject: [PATCH] feat(server): speed knob for replayed booth turns

HONE_TURN_CACHE_SPEED multiplies the replay pace: 3 streams a recorded
turn three times faster than it ran. Gaps still cap at
HONE_TURN_CACHE_MAX_GAP_MS.
---
 apps/server/scripts/hone-pi.ts | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/apps/server/scripts/hone-pi.ts b/apps/server/scripts/hone-pi.ts
index 0bfc89d4..7d9cf71e 100755
--- a/apps/server/scripts/hone-pi.ts
+++ b/apps/server/scripts/hone-pi.ts
@@ -29,6 +29,7 @@ const cacheDirs = (process.env.HONE_TURN_CACHE_DIR ?? "").split(NodePath.delimit
 const cacheDir = cacheDirs[0] ?? null;
 const recordTurns = process.env.HONE_TURN_CACHE_RECORD === "1";
 const maxGapMs = Number(process.env.HONE_TURN_CACHE_MAX_GAP_MS) || 1500;
+const speed = Number(process.env.HONE_TURN_CACHE_SPEED) || 1;
 const rpcMode = args.some(
   (arg, i) => arg === "--mode=rpc" || (arg === "--mode" && args[i + 1] === "rpc"),
 );
@@ -219,7 +220,8 @@ async function replay(recording: TurnRecording, prompt: PiRecord) {
   let clock = 0;
   let nextFile = 0;
   for (const { at, record } of recording.events) {
-    if (!state.finishNow) await sleep(Math.min(Math.max(0, at - clock), maxGapMs));
+    if (!state.finishNow)
+      await sleep(Math.min(Math.max(0, (at - clock) / speed), maxGapMs));
     clock = at;
     for (; nextFile < recording.files.length && recording.files[nextFile]!.at <= at; nextFile++) {
       const file = recording.files[nextFile]!;
