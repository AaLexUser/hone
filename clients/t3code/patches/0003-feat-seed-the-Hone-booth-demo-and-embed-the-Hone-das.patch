index 00000000..5d97ea4b
--- /dev/null
+++ b/apps/server/src/hone/HoneDemo.ts
@@ -0,0 +1,252 @@
+import {
+  CommandId,
+  HoneError,
+  type HoneDemoResetResult,
+  type ModelSelection,
+  ProjectId,
+  ProviderInstanceId,
+  ThreadId,
+} from "@t3tools/contracts";
+import { resolvePiSessionsDir } from "@t3tools/provider-pi/server/usage";
+import * as HostProcess from "@t3tools/shared/HostProcess";
+import * as Context from "effect/Context";
+import * as Crypto from "effect/Crypto";
+import * as DateTime from "effect/DateTime";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as Path from "effect/Path";
+import * as Schedule from "effect/Schedule";
+import * as Schema from "effect/Schema";
+import * as Semaphore from "effect/Semaphore";
+import { FetchHttpClient, HttpClient, HttpClientRequest } from "effect/http";
+
+import * as ServerConfig from "../config.ts";
+import * as EventSink from "../orchestration-v2/EventSink.ts";
+import * as ProjectService from "../project/ProjectService.ts";
+import { honeBaseUrl, isHoneError, readHoneConfig } from "./Hone.ts";
+import { piChatEvents } from "./piSessionHistory.ts";
+
+/** What Hone's `POST /api/demo/reset` returns. Session paths use `{{WORKSPACE}}` for the project folder. */
+const DemoManifest = Schema.Struct({
+  project: Schema.Struct({ title: Schema.NonEmptyString }),
+  files: Schema.Array(Schema.Struct({ path: Schema.NonEmptyString, base64: Schema.String })),
+  chats: Schema.Array(
+    Schema.Struct({
+      title: Schema.NonEmptyString,
+      sessionId: Schema.NonEmptyString,
+      jsonl: Schema.String,
+    }),
+  ),
+});
+type DemoManifest = typeof DemoManifest.Type;
+
+const WORKSPACE_PLACEHOLDER = "{{WORKSPACE}}";
+const SESSION_ID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+const PI_INSTANCE = ProviderInstanceId.make("pi");
+const PI_MODEL: ModelSelection = { instanceId: PI_INSTANCE, model: "default" };
+
+const demoError = (message: string) => new HoneError({ reason: "rejected", message });
+
+/** Pi keeps one session folder per working directory, named as Pi's session manager names it. */
+export function piSessionDirName(cwd: string): string {
+  return `--${cwd.replace(/^[/\\]/, "").replace(/[/\\:]/g, "-")}--`;
+}
+
+/** Manifest paths stay inside the project folder. */
+export function isSafeRelativePath(path: string): boolean {
+  return (
+    !path.startsWith("/") &&
+    !/^[A-Za-z]:/.test(path) &&
+    !path.split(/[/\\]/).some((part) => part === ".." || part === "")
+  );
+}
+
+export class HoneDemo extends Context.Service<
+  HoneDemo,
+  {
+    /** Restores Hone's prepared state and reseeds the demo project with fresh ids. */
+    readonly reset: Effect.Effect<HoneDemoResetResult, HoneError>;
+    /** Resets once Hone answers, when the server runs with HONE_DEMO=1. */
+    readonly resetAtStartup: Effect.Effect<void>;
+  }
+>()("t3/hone/HoneDemo") {}
+
+const make = Effect.gen(function* () {
+  const serverConfig = yield* ServerConfig.ServerConfig;
+  const projects = yield* ProjectService.ProjectService;
+  const eventSink = yield* EventSink.EventSinkV2;
+  const fileSystem = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const crypto = yield* Crypto.Crypto;
+  const http = yield* HttpClient.HttpClient;
+  const hostEnvironment = yield* HostProcess.Environment;
+  const homeDirectory = yield* HostProcess.HomeDirectory;
+  const lock = yield* Semaphore.make(1);
+  // Names the folder a reset created. Kept outside it so the Files panel stays clean.
+  const ownerMarker = path.join(serverConfig.baseDir, "hone-demo-folder");
+
+  /** Hone writes the real folder into its own copy of the sessions, so its trace pages match t3code. */
+  const fetchManifest = Effect.fn("HoneDemo.fetchManifest")(function* (workspace: string) {
+    const config = yield* readHoneConfig;
+    if (!config.demo) return yield* demoError("The server is not in demo mode.");
+    if (Option.isNone(config.url)) {
+      return yield* new HoneError({ reason: "unreachable", message: "HONE_URL is not set." });
+    }
+    const request = HttpClientRequest.post(`${honeBaseUrl(config.url.value)}/api/demo/reset`).pipe(
+      Option.isSome(config.token)
+        ? HttpClientRequest.bearerToken(config.token.value)
+        : (request) => request,
+      HttpClientRequest.bodyJsonUnsafe({ workspace }),
+    );
+    const response = yield* http.execute(request).pipe(
+      // Hone builds its prepared data once a day, which takes a while on the first reset.
+      Effect.timeout("3 minutes"),
+      Effect.mapError(
+        () => new HoneError({ reason: "unreachable", message: "Could not reach Hone." }),
+      ),
+    );
+    if (response.status < 200 || response.status >= 300) {
+      return yield* demoError(`Hone refused the demo reset (HTTP ${response.status}).`);
+    }
+    return yield* response.json.pipe(
+      Effect.flatMap(Schema.decodeUnknownEffect(DemoManifest)),
+      Effect.mapError(() => demoError("Hone sent a demo manifest this server cannot read.")),
+    );
+  });
+
+  const writeProjectFolder = Effect.fn("HoneDemo.writeProjectFolder")(function* (
+    folder: string,
+    manifest: DemoManifest,
+  ) {
+    yield* fileSystem.remove(folder, { recursive: true, force: true });
+    yield* fileSystem.makeDirectory(folder, { recursive: true });
+    yield* fileSystem.writeFileString(ownerMarker, folder);
+    for (const file of manifest.files) {
+      if (!isSafeRelativePath(file.path)) {
+        return yield* demoError(`The demo file path ${file.path} leaves the project folder.`);
+      }
+      const target = path.join(folder, file.path);
+      yield* fileSystem.makeDirectory(path.dirname(target), { recursive: true });
+      yield* fileSystem.writeFile(target, Buffer.from(file.base64, "base64"));
+    }
+  });
+
+  /** The project folder, resolved the way the project stores it, since Pi names its session folder after it. */
+  const projectFolder = Effect.gen(function* () {
+    const config = yield* readHoneConfig;
+    const folder = path.resolve(
+      Option.getOrElse(config.demoDir, () => path.join(serverConfig.baseDir, "hone-demo")),
+    );
+    yield* fileSystem.makeDirectory(folder, { recursive: true });
+    const resolved = yield* fileSystem.realPath(folder);
+    // Every reset deletes this folder, so only take over an empty one or one a reset created.
+    const entries = yield* fileSystem.readDirectory(resolved);
+    const owned = yield* fileSystem
+      .readFileString(ownerMarker)
+      .pipe(Effect.orElseSucceed(() => ""));
+    if (entries.length > 0 && owned !== resolved) {
+      return yield* demoError(
+        `Refusing to replace ${resolved}. It is not a Hone demo folder. Point HONE_DEMO_DIR at an empty folder.`,
+      );
+    }
+    return resolved;
+  });
+
+  /** Deleting the old chats first stops their Pi sessions before Hone forgets their traces. */
+  const deletePrevious = Effect.fn("HoneDemo.deletePrevious")(function* (folder: string) {
+    const previous = yield* projects.getByWorkspaceRoot(folder);
+    if (Option.isNone(previous)) return;
+    yield* projects.delete({
+      commandId: CommandId.make(`hone-demo:delete:${yield* crypto.randomUUIDv4()}`),
+      projectId: previous.value.id,
+      force: true,
+    });
+  });
+
+  const seed = Effect.fn("HoneDemo.seed")(function* (folder: string, manifest: DemoManifest) {
+    yield* writeProjectFolder(folder, manifest);
+
+    const projectId = ProjectId.make(yield* crypto.randomUUIDv4());
+    const { workspaceRoot } = yield* projects.create({
+      commandId: CommandId.make(`hone-demo:create:${projectId}`),
+      projectId,
+      title: manifest.project.title,
+      workspaceRoot: folder,
+    });
+    yield* projects.update({
+      commandId: CommandId.make(`hone-demo:model:${projectId}`),
+      projectId,
+      defaultModelSelection: PI_MODEL,
+    });
+
+    // Pi appends to a session file when a chat continues, so every reset writes clean copies
+    // under new names. A name stays bound to the deleted thread that used it.
+    const sessionsDir = path.join(
+      resolvePiSessionsDir(hostEnvironment, homeDirectory, path),
+      piSessionDirName(workspaceRoot),
+    );
+    yield* fileSystem.remove(sessionsDir, { recursive: true, force: true });
+    yield* fileSystem.makeDirectory(sessionsDir, { recursive: true });
+
+    const workspaceInJson = workspaceRoot.replaceAll("\\", "\\\\").replaceAll('"', '\\"');
+    const stamp = DateTime.formatIso(yield* DateTime.now).replace(/[:.]/g, "-");
+    let chatCount = 0;
+    for (const chat of manifest.chats) {
+      if (!SESSION_ID.test(chat.sessionId)) {
+        return yield* demoError(`The demo session id ${chat.sessionId} is not a UUID.`);
+      }
+      const sessionFile = path.join(sessionsDir, `${stamp}_${chat.sessionId}.jsonl`);
+      const jsonl = chat.jsonl.replaceAll(WORKSPACE_PLACEHOLDER, workspaceInJson);
+      yield* fileSystem.writeFileString(sessionFile, jsonl);
+      const events = piChatEvents({
+        threadId: ThreadId.make(yield* crypto.randomUUIDv4()),
+        projectId,
+        title: chat.title,
+        providerInstanceId: PI_INSTANCE,
+        modelSelection: PI_MODEL,
+        sessionFile,
+        jsonl,
+      });
+      if (events.length === 0) {
+        yield* Effect.logWarning("Skipped a demo chat with no user message", { title: chat.title });
+        continue;
+      }
+      yield* eventSink.write({ events });
+      chatCount += 1;
+    }
+    return { projectId, chatCount } satisfies HoneDemoResetResult;
+  });
+
+  const reset = Effect.gen(function* () {
+    const folder = yield* projectFolder;
+    yield* deletePrevious(folder);
+    return yield* seed(folder, yield* fetchManifest(folder));
+  }).pipe(
+    Effect.mapError((error) =>
+      isHoneError(error) ? error : demoError(`The demo reset failed: ${error.message}`),
+    ),
+    Effect.tapError((error) =>
+      Effect.logWarning("Hone demo reset failed", { message: error.message }),
+    ),
+    lock.withPermits(1),
+    Effect.withSpan("HoneDemo.reset"),
+  );
+
+  const resetAtStartup = Effect.gen(function* () {
+    const config = yield* readHoneConfig;
+    if (!config.demo) return;
+    // Hone may still be starting when t3code starts.
+    const result = yield* reset.pipe(
+      Effect.retry({ schedule: Schedule.spaced("5 seconds"), times: 60 }),
+    );
+    yield* Effect.logInfo("Seeded the Hone demo", result);
+  }).pipe(
+    Effect.catch((error) => Effect.logError("Could not seed the Hone demo", { cause: error })),
+  );
+
+  return { reset, resetAtStartup } satisfies HoneDemo["Service"];
+});
+
+export const layer = Layer.effect(HoneDemo, make).pipe(Layer.provide(FetchHttpClient.layer));
