+import {
+  OrchestrationV2DomainEvent,
+  ProjectId,
+  ProviderInstanceId,
+  ThreadId,
+} from "@t3tools/contracts";
+import { describe, expect, it } from "@effect/vitest";
+import * as Schema from "effect/Schema";
+
+import { isSafeRelativePath, piSessionDirName } from "./HoneDemo.ts";
+import { piChatEvents } from "./piSessionHistory.ts";
+
+type PayloadOf<T> = OrchestrationV2DomainEvent extends infer E
+  ? E extends { readonly type: infer U; readonly payload: infer P }
+    ? T extends U
+      ? P
+      : never
+    : never
+  : never;
+
+const line = (value: unknown) => JSON.stringify(value);
+const message = (id: string, parentId: string | null, at: string, body: unknown) =>
+  line({ type: "message", id, parentId, timestamp: `2026-11-14T05:${at}.000Z`, message: body });
+
+const jsonl = [
+  line({ type: "session", version: 3, id: "01a1538a-1241-780f-9a98-57543af269fa", cwd: "/w" }),
+  line({ type: "model_change", id: "m0", parentId: null, timestamp: "2026-11-14T05:00:00.000Z" }),
+  message("u1", "m0", "00:01", { role: "user", content: [{ type: "text", text: "Offer letter" }] }),
+  message("a1", "u1", "00:02", {
+    role: "assistant",
+    content: [
+      { type: "thinking", thinking: "Read the approval." },
+      { type: "toolCall", id: "call_1", name: "bash", arguments: { command: "pdftotext a.pdf -" } },
+      { type: "toolCall", id: "call_2", name: "read", arguments: { path: "Inbox/data.json" } },
+    ],
+  }),
+  message("r1", "a1", "00:03", {
+    role: "toolResult",
+    toolCallId: "call_1",
+    toolName: "bash",
+    content: [{ type: "text", text: "Salary 90000" }],
+    isError: false,
+  }),
+  message("r2", "r1", "00:04", {
+    role: "toolResult",
+    toolCallId: "call_2",
+    toolName: "read",
+    content: [{ type: "text", text: "{}" }],
+    isError: false,
+  }),
+  message("a2", "r2", "00:05", {
+    role: "assistant",
+    content: [
+      { type: "toolCall", id: "call_3", name: "write", arguments: { path: "x.md", content: "hi" } },
+    ],
+  }),
+  message("r3", "a2", "00:06", {
+    role: "toolResult",
+    toolCallId: "call_3",
+    toolName: "write",
+    content: [{ type: "text", text: "ok" }],
+    isError: false,
+  }),
+  message("a3", "r3", "00:07", {
+    role: "assistant",
+    content: [{ type: "text", text: "Done. [Offer letter.docx](Offer letter.docx)" }],
+  }),
+  message("u2", "a3", "01:00", { role: "user", content: "Also the PDF" }),
+  message("a4", "u2", "01:05", { role: "assistant", content: [{ type: "text", text: "Here." }] }),
+].join("\n");
+
+const seed = {
+  threadId: ThreadId.make("thread-1"),
+  projectId: ProjectId.make("project-1"),
+  title: "Offer letter for Mei",
+  providerInstanceId: ProviderInstanceId.make("pi"),
+  modelSelection: { instanceId: ProviderInstanceId.make("pi"), model: "default" },
+  sessionFile: "/sessions/--w--/2026_01a1538a.jsonl",
+  jsonl,
+};
+
+describe("piChatEvents", () => {
+  const events = piChatEvents(seed);
+  const payloads = <T extends OrchestrationV2DomainEvent["type"]>(type: T) =>
+    events.flatMap((event) => (event.type === type ? [event.payload] : [])) as Array<PayloadOf<T>>;
+
+  it("writes events the orchestration schema accepts", () => {
+    const encode = Schema.encodeUnknownSync(OrchestrationV2DomainEvent);
+    for (const event of events) expect(() => encode(event)).not.toThrow();
+    expect(new Set(events.map((event) => event.id)).size).toBe(events.length);
+  });
+
+  it("makes one completed run per user turn", () => {
+    const runs = payloads("run.created");
+    expect(runs.map((run) => [run.ordinal, run.status])).toEqual([
+      [1, "completed"],
+      [2, "completed"],
+    ]);
+    expect(
+      payloads("message.updated")
+        .filter((m) => m.role === "user")
+        .map((m) => m.text),
+    ).toEqual(["Offer letter", "Also the PDF"]);
+  });
+
+  it("binds the thread to the Pi session file so the next message resumes it", () => {
+    const [providerThread] = payloads("provider-thread.updated");
+    expect(providerThread?.nativeThreadRef?.nativeId).toBe(seed.sessionFile);
+    expect(providerThread?.lastRunOrdinal).toBe(2);
+    expect(payloads("thread.created")[0]?.activeProviderThreadId).toBe(providerThread?.id);
+    const replies = payloads("turn-item.updated").filter(
+      (item) => item.type === "assistant_message",
+    );
+    expect(replies.map((item) => item.providerThreadId)).toEqual([
+      providerThread?.id,
+      providerThread?.id,
+    ]);
+  });
+
+  it("maps tool calls the way the Pi adapter does", () => {
+    const tools = payloads("turn-item.updated").flatMap((item) =>
+      item.type === "command_execution"
+        ? [[item.type, item.input, item.output]]
+        : item.type === "dynamic_tool"
+          ? [[item.type, item.toolName, item.output]]
+          : item.type === "file_change"
+            ? [[item.type, item.fileName, item.newStr]]
+            : [],
+    );
+    expect(tools).toEqual([
+      ["command_execution", "pdftotext a.pdf -", "Salary 90000"],
+      ["dynamic_tool", "read", "{}"],
+      ["file_change", "x.md", "hi"],
+    ]);
+  });
+});
+
+describe("demo paths", () => {
+  it("names the session folder as Pi does", () => {
+    expect(piSessionDirName("/Users/mei/Offer letters")).toBe("--Users-mei-Offer letters--");
+  });
+
+  it("keeps manifest files inside the project folder", () => {
+    expect(isSafeRelativePath("Inbox/Offer letter template.docx")).toBe(true);
+    expect(isSafeRelativePath("../escape.docx")).toBe(false);
+    expect(isSafeRelativePath("/etc/passwd")).toBe(false);
+  });
+});
diff --git a/apps/server/src/hone/piSessionHistory.ts b/apps/server/src/hone/piSessionHistory.ts
new file mode 100644
index 00000000..8c652e70
--- /dev/null
+++ b/apps/server/src/hone/piSessionHistory.ts
@@ -0,0 +1,458 @@
+import {
+  EventId,
+  MessageId,
+  type ModelSelection,
+  type OrchestrationV2DomainEvent,
+  type OrchestrationV2ProviderThread,
+  type OrchestrationV2TurnItem,
+  type ProjectId,
+  ProviderDriverKind,
+  type ProviderInstanceId,
+  type ThreadId,
+} from "@t3tools/contracts";
+import { derive } from "@t3tools/provider-core/server/IdAllocator";
+import * as DateTime from "effect/DateTime";
+import * as Option from "effect/Option";
+import * as Schema from "effect/Schema";
+
+/** One Pi session entry. Pi stores a tree, and `parentId` links each entry to the one before it. */
+interface PiEntry {
+  readonly id: string;
+  readonly parentId: string | null;
+  readonly timestamp: string;
+  readonly message: Record<string, unknown> | null;
+}
+
+const PI = ProviderDriverKind.make("pi");
+const decodeJsonLine = Schema.decodeUnknownOption(Schema.fromJsonString(Schema.Unknown));
+
+const isRecord = (value: unknown): value is Record<string, unknown> =>
+  typeof value === "object" && value !== null && !Array.isArray(value);
+
+const stringField = (record: unknown, key: string): string | undefined => {
+  const value = isRecord(record) ? record[key] : undefined;
+  return typeof value === "string" ? value : undefined;
+};
+
+function contentBlocks(message: Record<string, unknown>): ReadonlyArray<Record<string, unknown>> {
+  const content = message["content"];
+  if (typeof content === "string") return [{ type: "text", text: content }];
+  return Array.isArray(content) ? content.filter(isRecord) : [];
+}
+
+const blocksText = (blocks: ReadonlyArray<Record<string, unknown>>) =>
+  blocks
+    .filter((block) => block["type"] === "text")
+    .map((block) => stringField(block, "text") ?? "")
+    .join("");
+
+/** The conversation Pi resumes from, which is the path from the session's last entry back to its root. */
+function piSessionPath(jsonl: string): ReadonlyArray<PiEntry> {
+  const entries = new Map<string, PiEntry>();
+  let leaf: PiEntry | undefined;
+  for (const line of jsonl.split("\n")) {
+    if (line.trim() === "") continue;
+    const decoded = decodeJsonLine(line);
+    if (Option.isNone(decoded)) continue;
+    const parsed = decoded.value;
+    const id = stringField(parsed, "id");
+    const timestamp = stringField(parsed, "timestamp");
+    if (id === undefined || timestamp === undefined || Number.isNaN(Date.parse(timestamp)))
+      continue;
+    if (stringField(parsed, "type") === "session") continue;
+    const message = isRecord(parsed) ? parsed["message"] : undefined;
+    const entry: PiEntry = {
+      id,
+      parentId: stringField(parsed, "parentId") ?? null,
+      timestamp,
+      message: stringField(parsed, "type") === "message" && isRecord(message) ? message : null,
+    };
+    entries.set(id, entry);
+    leaf = entry;
+  }
+  const path: Array<PiEntry> = [];
+  for (let entry = leaf; entry !== undefined;) {
+    path.push(entry);
+    entry = entry.parentId === null ? undefined : entries.get(entry.parentId);
+  }
+  return path.toReversed();
+}
+
+export interface PiChatSeed {
+  readonly threadId: ThreadId;
+  readonly projectId: ProjectId;
+  readonly title: string;
+  readonly providerInstanceId: ProviderInstanceId;
+  readonly modelSelection: ModelSelection;
+  /** Absolute path of the session file Pi resumes with `switch_session`. */
+  readonly sessionFile: string;
+  readonly jsonl: string;
+}
+
+/**
+ * The events a finished Pi chat would have left behind. Each user turn is one completed run, tool
+ * calls map the way the Pi adapter maps them, and the provider thread is bound to the session
+ * file so the next message resumes the same Pi session.
+ */
+export function piChatEvents(seed: PiChatSeed): ReadonlyArray<OrchestrationV2DomainEvent> {
+  const path = piSessionPath(seed.jsonl);
+  const toolResults = new Map<string, PiEntry>();
+  for (const entry of path) {
+    const callId = stringField(entry.message, "toolCallId");
+    if (entry.message?.["role"] === "toolResult" && callId !== undefined) {
+      toolResults.set(callId, entry);
+    }
+  }
+  const turns: Array<Array<PiEntry>> = [];
+  for (const entry of path) {
+    const role = entry.message?.["role"];
+    if (role === "user") turns.push([entry]);
+    else if (role === "assistant" || role === "toolResult") turns.at(-1)?.push(entry);
+  }
+  const first = turns[0]?.[0];
+  if (first === undefined) return [];
+
+  const { threadId } = seed;
+  const at = (timestamp: string) => DateTime.makeUnsafe(timestamp);
+  const createdAt = at(first.timestamp);
+  const lastEntry = path.at(-1)!;
+  const updatedAt = at(lastEntry.timestamp);
+  const providerThreadId = derive.providerThread({ driver: PI, nativeThreadId: seed.sessionFile });
+  const providerThread: OrchestrationV2ProviderThread = {
+    id: providerThreadId,
+    driver: PI,
+    providerInstanceId: seed.providerInstanceId,
+    providerSessionId: null,
+    appThreadId: threadId,
+    ownerNodeId: null,
+    nativeThreadRef: { driver: PI, nativeId: seed.sessionFile, strength: "strong" },
+    nativeConversationHeadRef: { driver: PI, nativeId: lastEntry.id, strength: "strong" },
+    status: "idle",
+    firstRunOrdinal: 1,
+    lastRunOrdinal: turns.length,
+    handoffIds: [],
+    forkedFrom: null,
+    pendingBackgroundTasks: [],
+    createdAt,
+    updatedAt,
+  };
+
+  let eventCount = 0;
+  const eventId = () => EventId.make(`hone-demo:${threadId}:${eventCount++}`);
+  const events: Array<OrchestrationV2DomainEvent> = [
+    {
+      id: eventId(),
+      type: "thread.created",
+      threadId,
+      providerInstanceId: seed.providerInstanceId,
+      occurredAt: createdAt,
+      payload: {
+        createdBy: "user",
+        creationSource: "web",
+        id: threadId,
+        projectId: seed.projectId,
+        title: seed.title,
+        providerInstanceId: seed.providerInstanceId,
+        modelSelection: seed.modelSelection,
+        runtimeMode: "full-access",
+        interactionMode: "default",
+        branch: null,
+        worktreePath: null,
+        activeProviderThreadId: providerThreadId,
+        lineage: { parentThreadId: null, relationshipToParent: null, rootThreadId: threadId },
+        forkedFrom: null,
+        createdAt,
+        updatedAt,
+        archivedAt: null,
+        // The prepared history spans weeks. Keep every chat in the sidebar instead of auto settling it.
+        settledOverride: "active",
+        settledAt: null,
+        lastVisitedAt: updatedAt,
+        deletedAt: null,
+      },
+    },
+    {
+      id: eventId(),
+      type: "provider-thread.updated",
+      threadId,
+      driver: PI,
+      providerInstanceId: seed.providerInstanceId,
+      occurredAt: createdAt,
+      payload: providerThread,
+    },
+  ];
+
+  turns.forEach((turn, index) => {
+    const userEntry = turn[0]!;
+    const replies = turn.filter((entry) => entry.message?.["role"] === "assistant");
+    const runId = derive.run({ threadId, ordinal: index + 1 });
+    const nodeId = derive.rootNode({ runId });
+    const attemptId = derive.runAttempt({ runId, attemptOrdinal: 1 });
+    const userMessageId = MessageId.make(`${threadId}:user:${userEntry.id}`);
+    const startedAt = at(userEntry.timestamp);
+    const completedAt = at(turn.at(-1)!.timestamp);
+    const runMeta = {
+      threadId,
+      runId,
+      nodeId,
+      providerInstanceId: seed.providerInstanceId,
+    } as const;
+    const itemBase = (id: OrchestrationV2TurnItem["id"], start: string, end: string) => ({
+      id,
+      threadId,
+      runId,
+      nodeId,
+      providerThreadId,
+      providerTurnId: null,
+      nativeItemRef: null,
+      parentItemId: null,
+      ordinal: 0,
+      status: "completed" as const,
+      title: null,
+      startedAt: at(start),
+      completedAt: at(end),
+      updatedAt: at(end),
+    });
+    const userText = blocksText(contentBlocks(userEntry.message!));
+
+    events.push(
+      {
+        id: eventId(),
+        type: "run.created",
+        ...runMeta,
+        occurredAt: startedAt,
+        payload: {
+          id: runId,
+          threadId,
+          ordinal: index + 1,
+          providerInstanceId: seed.providerInstanceId,
+          modelSelection: seed.modelSelection,
+          providerThreadId,
+          userMessageId,
+          rootNodeId: nodeId,
+          activeAttemptId: attemptId,
+          status: "completed",
+          queuePosition: null,
+          requestedAt: startedAt,
+          startedAt,
+          completedAt,
+          checkpointId: null,
+          contextHandoffId: null,
+          workspacePreparation: { type: "root" },
+        },
+      },
+      {
+        id: eventId(),
+        type: "run-attempt.created",
+        ...runMeta,
+        occurredAt: startedAt,
+        payload: {
+          id: attemptId,
+          nativeThreadId: seed.sessionFile,
+          runId,
+          attemptOrdinal: 1,
+          rootNodeId: nodeId,
+          providerInstanceId: seed.providerInstanceId,
+          providerThreadId,
+          providerTurnId: null,
+          reason: "initial",
+          status: "completed",
+          startedAt,
+          completedAt,
+        },
+      },
+      {
+        id: eventId(),
+        type: "node.updated",
+        ...runMeta,
+        occurredAt: startedAt,
+        payload: {
+          id: nodeId,
+          threadId,
+          runId,
+          parentNodeId: null,
+          rootNodeId: nodeId,
+          kind: "root_turn",
+          status: "completed",
+          countsForRun: true,
+          providerThreadId,
+          providerTurnId: null,
+          nativeItemRef: null,
+          runtimeRequestId: null,
+          checkpointScopeId: null,
+          startedAt,
+          completedAt,
+        },
+      },
+      {
+        id: eventId(),
+        type: "message.updated",
+        ...runMeta,
+        occurredAt: startedAt,
+        payload: {
+          createdBy: "user",
+          creationSource: "web",
+          id: userMessageId,
+          threadId,
+          runId,
+          nodeId,
+          role: "user",
+          text: userText,
+          attachments: [],
+          streaming: false,
+          createdAt: startedAt,
+          updatedAt: startedAt,
+        },
+      },
+      {
+        id: eventId(),
+        type: "turn-item.updated",
+        ...runMeta,
+        occurredAt: startedAt,
+        payload: {
+          ...itemBase(
+            derive.userTurnItem({ messageId: userMessageId }),
+            userEntry.timestamp,
+            userEntry.timestamp,
+          ),
+          createdBy: "user",
+          creationSource: "web",
+          type: "user_message",
+          messageId: userMessageId,
+          inputIntent: "turn_start",
+          text: userText,
+          attachments: [],
+        },
+      },
+    );
+
+    for (const reply of replies) {
+      contentBlocks(reply.message!).forEach((block, blockIndex) => {
+        const nativeItemId = `${threadId}:${reply.id}:c${blockIndex}`;
+        const itemId = derive.turnItemFromProviderItem({ driver: PI, nativeItemId });
+        const occurredAt = at(reply.timestamp);
+        const push = (item: OrchestrationV2TurnItem) =>
+          events.push({
+            id: eventId(),
+            type: "turn-item.updated",
+            ...runMeta,
+            driver: PI,
+            occurredAt: item.completedAt ?? occurredAt,
+            payload: item,
+          });
+        if (block["type"] === "thinking") {
+          const text = stringField(block, "thinking")?.trim() ?? "";
+          if (text === "") return;
+          push({
+            ...itemBase(itemId, reply.timestamp, reply.timestamp),
+            type: "reasoning",
+            text,
+            streaming: false,
+          });
+          return;
+        }
+        if (block["type"] === "text") {
+          const text = stringField(block, "text") ?? "";
+          if (text.trim() === "") return;
+          const messageId = derive.messageFromProviderItem({ driver: PI, nativeItemId });
+          events.push({
+            id: eventId(),
+            type: "message.updated",
+            ...runMeta,
+            driver: PI,
+            occurredAt,
+            payload: {
+              createdBy: "agent",
+              creationSource: "provider",
+              id: messageId,
+              threadId,
+              runId,
+              nodeId,
+              role: "assistant",
+              text,
+              attachments: [],
+              streaming: false,
+              createdAt: occurredAt,
+              updatedAt: occurredAt,
+            },
+          });
+          push({
+            ...itemBase(itemId, reply.timestamp, reply.timestamp),
+            type: "assistant_message",
+            messageId,
+            text,
+            streaming: false,
+          });
+          return;
+        }
+        if (block["type"] === "toolCall") {
+          const resultEntry = toolResults.get(stringField(block, "id") ?? "");
+          const item = toolItem(
+            block,
+            resultEntry?.message ?? null,
+            itemBase(itemId, reply.timestamp, resultEntry?.timestamp ?? reply.timestamp),
+          );
+          if (item !== null) push(item);
+        }
+      });
+    }
+  });
+  return events;
+}
+
+type ItemBase = Omit<
+  Extract<OrchestrationV2TurnItem, { type: "reasoning" }>,
+  "type" | "text" | "streaming"
+>;
+
+/** Mirrors the Pi adapter. Bash runs a command, edit and write change a file, and any other tool is a dynamic tool. */
+function toolItem(
+  call: Record<string, unknown>,
+  result: Record<string, unknown> | null,
+  itemBase: ItemBase,
+): OrchestrationV2TurnItem | null {
+  const callId = stringField(call, "id");
+  const toolName = stringField(call, "name");
+  if (callId === undefined || toolName === undefined) return null;
+  const args = isRecord(call["arguments"]) ? call["arguments"] : {};
+  const output = result === null ? "" : blocksText(contentBlocks(result));
+  const failed = result?.["isError"] === true;
+  const base = {
+    ...itemBase,
+    nativeItemRef: { driver: PI, nativeId: callId, strength: "strong" as const },
+    status: failed ? ("failed" as const) : ("completed" as const),
+    title: toolName,
+  };
+  if (toolName === "bash") {
+    const details = result?.["details"];
+    const exitCode = isRecord(details) ? details["exitCode"] : undefined;
+    return {
+      ...base,
+      type: "command_execution",
+      input: stringField(args, "command") ?? "",
+      ...(output === "" ? {} : { output }),
+      ...(typeof exitCode === "number" ? { exitCode } : {}),
+    };
+  }
+  const fileName = stringField(args, "path") ?? stringField(args, "file_path");
+  if ((toolName === "edit" || toolName === "write") && fileName !== undefined) {
+    const diffStr =
+      stringField(result?.["details"], "patch") ??
+      (failed && output.trim() !== "" ? output : undefined);
+    const newStr = toolName === "write" ? stringField(args, "content") : undefined;
+    return {
+      ...base,
+      type: "file_change",
+      fileName,
+      ...(diffStr === undefined ? {} : { diffStr }),
+      ...(newStr === undefined ? {} : { newStr }),
+    };
+  }
+  return {
+    ...base,
+    type: "dynamic_tool",
+    toolName,
+    input: args,
+    ...(output === "" ? {} : { output }),
+  };
+}
diff --git a/apps/server/src/observability/RpcInstrumentation.ts b/apps/server/src/observability/RpcInstrumentation.ts
index e8219fe7..decbb357 100644
--- a/apps/server/src/observability/RpcInstrumentation.ts
+++ b/apps/server/src/observability/RpcInstrumentation.ts
@@ -167,6 +167,8 @@ const RPC_AGGREGATES = {
   [WS_METHODS.providerUploadFeedback]: "provider",
   [WS_METHODS.honeStatus]: "hone",
   [WS_METHODS.honeFeedback]: "hone",
