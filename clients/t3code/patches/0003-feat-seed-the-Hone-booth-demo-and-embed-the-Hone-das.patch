new file mode 100644
index 00000000..6dc7d389
--- /dev/null
+++ b/apps/web/src/components/hone/HonePage.tsx
@@ -0,0 +1,81 @@
+import { ExternalLinkIcon } from "lucide-react";
+import type { SVGProps } from "react";
+
+import { isElectron } from "~/env";
+import { usePrimaryEnvironmentId } from "~/state/environments";
+import { useHoneStatus } from "../chat/HoneControls";
+import { Button } from "../ui/button";
+import { Empty, EmptyDescription, EmptyHeader, EmptyTitle } from "../ui/empty";
+import { SidebarInset } from "../ui/sidebar";
+import { WorkspaceBreadcrumb, WorkspaceBreadcrumbItem } from "../WorkspaceBreadcrumb";
+import { WorkspacePageHeader } from "../WorkspacePageHeader";
+
+/** Hone's mark drawn as a line icon, three document lines with the middle one honed to a point. */
+export function HoneGlyph(props: SVGProps<SVGSVGElement>) {
+  return (
+    <svg
+      xmlns="http://www.w3.org/2000/svg"
+      viewBox="0 0 24 24"
+      fill="none"
+      stroke="currentColor"
+      strokeWidth={2}
+      strokeLinecap="round"
+      strokeLinejoin="round"
+      aria-hidden
+      {...props}
+    >
+      <path d="M5 6.5h8" />
+      <path d="M5 12h10" />
+      <path d="M15 10.25 19.5 12 15 13.75Z" fill="currentColor" />
+      <path d="M5 17.5h5.5" />
+    </svg>
+  );
+}
+
+/** The Hone dashboard inside t3code, so the optimizer is one click from the chats. */
+export function HonePage() {
+  const status = useHoneStatus(usePrimaryEnvironmentId());
+  const dashboardUrl = status?.dashboardUrl ?? null;
+  return (
+    <SidebarInset className="h-dvh min-h-0 overflow-hidden overscroll-y-none">
+      <div className="flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden bg-background">
+        <WorkspacePageHeader electron={isElectron} className="border-b border-border">
+          <WorkspaceBreadcrumb ariaLabel="Hone breadcrumb">
+            <WorkspaceBreadcrumbItem current>
+              <h1 className="truncate">Hone</h1>
+            </WorkspaceBreadcrumbItem>
+          </WorkspaceBreadcrumb>
+          <div className="min-w-0 flex-1" />
+          {dashboardUrl === null ? null : (
+            <Button
+              size="xs"
+              variant="ghost"
+              render={<a href={dashboardUrl} target="_blank" rel="noreferrer" />}
+            >
+              Open in a new tab
+              <ExternalLinkIcon />
+            </Button>
+          )}
+        </WorkspacePageHeader>
+        {status === null ? null : dashboardUrl === null ? (
+          <Empty className="flex-1">
+            <EmptyHeader>
+              <EmptyTitle>Hone is not connected</EmptyTitle>
+              <EmptyDescription>
+                Start the server with HONE_URL, or HONE_DASHBOARD_URL, to show the Hone dashboard
+                here.
+              </EmptyDescription>
+            </EmptyHeader>
+          </Empty>
+        ) : (
+          // oxlint-disable-next-line react/iframe-missing-sandbox -- Hone is another origin, and its dashboard needs scripts and its own origin for its API calls and saved theme.
+          <iframe
+            src={dashboardUrl}
+            title="Hone dashboard"
+            className="min-h-0 w-full flex-1 border-0 bg-background"
+          />
+        )}
+      </div>
+    </SidebarInset>
+  );
+}
