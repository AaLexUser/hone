+/** The rating of the newest rated line in Hone's feedback for a session. */
+export function honeFeedbackRating(feedback: string | null): HoneFeedbackRating | null {
+  const rated = (feedback ?? "")
+    .split("\n")
+    .map((line) => line.trim())
+    .findLast((line) => line.startsWith("👍") || line.startsWith("👎"));
+  return rated === undefined ? null : rated.startsWith("👍") ? "up" : "down";
+}
