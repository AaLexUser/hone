+/** Hone's trace id for the thread's Pi session, read from the stored projection so it still works after Pi's process exits. */
+const threadTraceId = Effect.fn("hone.threadTraceId")(function* (threadId: ThreadId) {
+  const threadManagement = yield* ThreadManagementService.ThreadManagementService;
+  const projection = yield* threadManagement.getThreadRecords(threadId, ["providerThreads"]);
+  const piThreads = projection.providerThreads.filter((thread) => thread.driver === "pi");
+  const piThread =
+    piThreads.find((thread) => thread.id === projection.thread.activeProviderThreadId) ??
+    piThreads.at(-1);
+  const sessionFile = piThread?.nativeThreadRef?.nativeId ?? null;
+  if (sessionFile === null) {
+    return yield* new HoneError({
+      reason: "no-pi-session",
+      message: "This thread has no Pi session yet.",
+    });
+  }
+  const fileSystem = yield* FileSystem.FileSystem;
+  const contents = yield* fileSystem
+    .readFileString(sessionFile)
+    .pipe(Effect.orElseSucceed(() => ""));
+  const sessionId = piSessionIdOf(sessionFile, contents);
+  if (sessionId === null) {
+    return yield* new HoneError({
+      reason: "no-pi-session",
+      message: "Could not read the Pi session id.",
+    });
+  }
+  return honeTraceId(sessionId);
+});
+
+const asHoneError = <A, E extends { readonly message: string }, R>(
+  effect: Effect.Effect<A, E, R>,
+): Effect.Effect<A, HoneError, R> =>
+  Effect.mapError(effect, (error) =>
+    isHoneError(error)
+      ? error
+      : new HoneError({
+          reason: "no-pi-session",
+          message: `Could not load the thread: ${error.message}`,
+        }),
+  );
+
+export const honeFeedback = Effect.fn("hone.feedback")(function* (input: HoneFeedbackInput) {
+  const text = honeFeedbackText(input);
+  if (text === null) {
+    return yield* new HoneError({ reason: "rejected", message: "Add a rating or a comment." });
+  }
+  const config = yield* readHoneConfig;
+  if (Option.isNone(config.url)) {
+    return yield* new HoneError({ reason: "unreachable", message: "HONE_URL is not set." });
+  }
+  const traceId = yield* threadTraceId(input.threadId);
+  const http = yield* HttpClient.HttpClient;
+  const request = HttpClientRequest.post(
+    `${honeBaseUrl(config.url.value)}/api/traces/${traceId}/feedback`,
+  ).pipe(
+    Option.isSome(config.token)
+      ? HttpClientRequest.bearerToken(config.token.value)
+      : (request) => request,
+    HttpClientRequest.bodyJsonUnsafe({ text }),
+  );
+  const response = yield* http.execute(request).pipe(
+    Effect.timeout("5 seconds"),
+    Effect.mapError(
+      () => new HoneError({ reason: "unreachable", message: "Could not reach Hone." }),
+    ),
+  );
+  if (response.status === 404) {
+    return yield* new HoneError({
+      reason: "not-published",
+      message: "Hone has not received this session yet. Try again after the reply finishes.",
+    });
+  }
+  if (response.status < 200 || response.status >= 300) {
+    return yield* new HoneError({
+      reason: "rejected",
+      message: `Hone rejected the feedback (HTTP ${response.status}).`,
+    });
+  }
+  return { traceId } satisfies HoneFeedbackResult;
+}, asHoneError);
+
+const HoneTrace = Schema.Struct({ feedback: Schema.NullishOr(Schema.String) });
+
+/** The feedback Hone already holds for the thread's session. It is null until Hone has the session. */
+export const honeThreadFeedback = Effect.fn("hone.threadFeedback")(function* (
+  input: HoneThreadFeedbackInput,
+) {
+  const config = yield* readHoneConfig;
+  if (Option.isNone(config.url)) {
+    return yield* new HoneError({ reason: "unreachable", message: "HONE_URL is not set." });
+  }
+  const traceId = yield* threadTraceId(input.threadId);
+  const http = yield* HttpClient.HttpClient;
+  const response = yield* http
+    .execute(HttpClientRequest.get(`${honeBaseUrl(config.url.value)}/api/traces/${traceId}`))
+    .pipe(
       Effect.timeout("5 seconds"),
       Effect.mapError(
         () => new HoneError({ reason: "unreachable", message: "Could not reach Hone." }),
       ),
     );
-    if (response.status === 404) {
-      return yield* new HoneError({
-        reason: "not-published",
-        message: "Hone has not received this session yet. Try again after the reply finishes.",
-      });
-    }
-    if (response.status < 200 || response.status >= 300) {
-      return yield* new HoneError({
-        reason: "rejected",
-        message: `Hone rejected the feedback (HTTP ${response.status}).`,
-      });
-    }
-    return { traceId } satisfies HoneFeedbackResult;
-  },
-  (effect) =>
-    effect.pipe(
-      Effect.catchIf(
-        (error) => !isHoneError(error),
-        (error) =>
-          Effect.fail(
-            new HoneError({
-              reason: "no-pi-session",
-              message: `Could not load the thread: ${error.message}`,
-            }),
-          ),
-      ),
+  if (response.status === 404) {
+    return { traceId, feedback: null } satisfies HoneThreadFeedback;
+  }
+  const trace = yield* response.json.pipe(
+    Effect.flatMap(Schema.decodeUnknownEffect(HoneTrace)),
+    Effect.mapError(
+      () => new HoneError({ reason: "rejected", message: "Hone sent an unreadable trace." }),
     ),
-);
+  );
+  const feedback = trace.feedback?.trim() ?? "";
+  return { traceId, feedback: feedback === "" ? null : feedback } satisfies HoneThreadFeedback;
+}, asHoneError);
