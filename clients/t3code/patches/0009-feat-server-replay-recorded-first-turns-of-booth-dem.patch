+// @effect-diagnostics nodeBuiltinImport:off
+// The booth demo's agent turn cache. A recording is the first turn of a real Pi chat, its
+// RPC events, the files it wrote and its session file. A new chat whose first prompt, model and
+// project folder match a recording replays it instead of calling the model.
+import * as NodeCrypto from "node:crypto";
+import * as NodeFS from "node:fs";
+import * as NodePath from "node:path";
+
+export const TURN_RECORDING_VERSION = 1;
+
+export interface PiModelChoice {
+  readonly provider: string;
+  readonly modelId: string;
+}
+
+/** What a first prompt depends on. Two prompts with the same key see the same world. */
+export interface TurnKeyInput {
+  readonly message: string;
+  readonly images: ReadonlyArray<{ readonly data: string; readonly mimeType: string }>;
+  readonly model: PiModelChoice | null;
+  readonly thinkingLevel: string | null;
+  readonly cwd: string;
+}
+
+/** A file t3code saved for an upload, named in the prompt as `[Attached file "name" is saved at: path]`. */
+export interface PromptAttachment {
+  readonly name: string;
+  readonly path: string;
+  readonly extractedPath: string | null;
+}
+
+export interface TurnRecording {
+  readonly version: typeof TURN_RECORDING_VERSION;
+  readonly key: string;
+  readonly recordedAt: string;
+  readonly source: {
+    readonly sessionId: string;
+    readonly sessionFile: string;
+    readonly cwd: string;
+    readonly model: PiModelChoice | null;
+    readonly thinkingLevel: string | null;
+  };
+  readonly prompt: string;
+  readonly attachments: ReadonlyArray<PromptAttachment>;
+  /** Pi's stdout records from the prompt to `agent_settled`, `at` in ms after the prompt. */
+  readonly events: ReadonlyArray<{ readonly at: number; readonly record: Record<string, unknown> }>;
+  /** Files the turn created or changed in the project folder, relative to it, as base64. */
+  readonly files: ReadonlyArray<{
+    readonly at: number;
+    readonly path: string;
+    readonly base64: string;
+  }>;
+  /** The Pi session file as it stood when the turn settled. */
+  readonly session: string;
+}
+
+const ATTACHMENT_PATTERN =
+  /\[Attached (?:file|image) "((?:[^"\\]|\\.)*)" is saved at: (.+?)(?: \(text extracted to: (.+?)\))?\]/g;
+
+export function promptAttachments(message: string): PromptAttachment[] {
+  return [...message.matchAll(ATTACHMENT_PATTERN)].map((match) => ({
+    name: match[1]!,
+    path: match[2]!,
+    extractedPath: match[3] ?? null,
+  }));
+}
+
+function sha256(data: string | Buffer): string {
+  return NodeCrypto.createHash("sha256").update(data).digest("hex");
+}
+
+function fileHash(file: string): string {
+  try {
+    return sha256(NodeFS.readFileSync(file));
+  } catch {
+    return "missing";
+  }
+}
+
+/** Every file under `root` with its content hash, hidden entries skipped, sorted by path. */
+export function folderSnapshot(root: string): Map<string, string> {
+  const snapshot = new Map<string, string>();
+  const walk = (dir: string) => {
+    let entries: NodeFS.Dirent[];
+    try {
+      entries = NodeFS.readdirSync(dir, { withFileTypes: true });
+    } catch {
+      return;
+    }
+    for (const entry of entries) {
+      if (entry.name.startsWith(".")) continue;
+      const full = NodePath.join(dir, entry.name);
+      if (entry.isDirectory()) walk(full);
+      else if (entry.isFile()) snapshot.set(NodePath.relative(root, full), fileHash(full));
+    }
+  };
+  walk(root);
+  return new Map([...snapshot].toSorted(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0)));
+}
+
+/**
+ * The cache key. An upload's saved path changes with every upload, so the prompt counts it by
+ * name and content. The project folder counts whole, because the agent reads it.
+ */
+export function turnKey(input: TurnKeyInput): string {
+  const message = input.message.replace(
+    ATTACHMENT_PATTERN,
+    (_match, name: string, saved: string) => `[Attached "${name}" ${fileHash(saved)}]`,
+  );
+  return sha256(
+    JSON.stringify({
+      version: TURN_RECORDING_VERSION,
+      message,
+      images: input.images.map((image) => [image.mimeType, sha256(image.data)]),
+      model: input.model,
+      thinkingLevel: input.thinkingLevel,
+      folder: [...folderSnapshot(input.cwd)],
+    }),
+  );
+}
+
+/** Pairs of recorded and current values, longest first so a path never loses to its prefix. */
+export function replayReplacements(
+  recording: TurnRecording,
+  current: {
+    readonly sessionId: string;
+    readonly sessionFile: string;
+    readonly cwd: string;
+    readonly attachments: ReadonlyArray<PromptAttachment>;
+  },
+): Array<readonly [string, string]> {
+  const pairs: Array<readonly [string, string]> = [
+    [recording.source.sessionFile, current.sessionFile],
+    [recording.source.cwd, current.cwd],
+    [recording.source.sessionId, current.sessionId],
+  ];
+  recording.attachments.forEach((recorded, index) => {
+    const now = current.attachments[index];
+    if (now === undefined) return;
+    pairs.push([recorded.path, now.path]);
+    if (recorded.extractedPath !== null && now.extractedPath !== null) {
+      pairs.push([recorded.extractedPath, now.extractedPath]);
+    }
+  });
+  return pairs
+    .filter(([from, to]) => from !== "" && from !== to)
+    .toSorted(([a], [b]) => b.length - a.length);
+}
+
+export function applyReplacements(
+  text: string,
+  replacements: ReadonlyArray<readonly [string, string]>,
+): string {
+  let out = text;
+  for (const [from, to] of replacements) {
+    out = out.split(from).join(to);
+    // Paths also appear inside JSON strings, with their slashes and quotes escaped.
+    const escapedFrom = JSON.stringify(from).slice(1, -1);
+    if (escapedFrom !== from) out = out.split(escapedFrom).join(JSON.stringify(to).slice(1, -1));
+  }
+  return out;
+}
+
+/** Whether a Pi session file already holds a user message, so a prompt to it is not a first turn. */
+export function sessionHasUserMessage(sessionFile: string | null): boolean {
+  if (sessionFile === null) return false;
+  let text: string;
+  try {
+    text = NodeFS.readFileSync(sessionFile, "utf8");
+  } catch {
+    return false;
+  }
+  return text.split("\n").some((line) => line.includes('"role":"user"'));
+}
+
+export function recordingPath(dir: string, key: string): string {
+  return NodePath.join(dir, `${key}.json`);
+}
+
+export function readRecording(dir: string, key: string): TurnRecording | null {
+  try {
+    const parsed = JSON.parse(
+      NodeFS.readFileSync(recordingPath(dir, key), "utf8"),
+    ) as TurnRecording;
+    return parsed.version === TURN_RECORDING_VERSION && parsed.key === key ? parsed : null;
+  } catch {
+    return null;
+  }
+}
+
+/** Files that are new or changed since `before`, relative to `root`. */
+export function changedFiles(
+  root: string,
+  before: ReadonlyMap<string, string>,
+): Array<{ path: string; hash: string }> {
+  const changed: Array<{ path: string; hash: string }> = [];
+  for (const [file, hash] of folderSnapshot(root)) {
+    if (before.get(file) !== hash) changed.push({ path: file, hash });
+  }
+  return changed;
+}
