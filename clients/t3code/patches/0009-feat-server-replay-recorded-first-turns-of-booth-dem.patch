+// @effect-diagnostics nodeBuiltinImport:off globalDate:off
+import * as NodeChildProcess from "node:child_process";
+import * as NodeFS from "node:fs";
+import * as NodeOS from "node:os";
+import * as NodePath from "node:path";
+import * as NodeURL from "node:url";
+
+import { describe, expect, it } from "@effect/vitest";
+
+import { applyReplacements, promptAttachments, turnKey } from "./hone-pi-turn-cache.ts";
+
+const WRAPPER = NodeURL.fileURLToPath(new URL("./hone-pi.ts", import.meta.url));
+
+// A stand-in Pi. Each start makes a new session file. A prompt writes a file, logs that the
+// model ran and settles. It never answers a prompt it did not get.
+const FAKE_PI = `
+const fs = require("node:fs"), path = require("node:path");
+const dir = process.env.FAKE_PI_SESSIONS, id = "0000aaaa-0000-4000-8000-" + String(Date.now()).padStart(12, "0");
+const sessionFile = path.join(dir, id + ".jsonl");
+const out = (r) => process.stdout.write(JSON.stringify(r) + "\\n");
+let buffer = "";
+process.stdin.on("data", (chunk) => {
+  buffer += chunk;
+  for (let i; (i = buffer.indexOf("\\n")) >= 0; ) {
+    const r = JSON.parse(buffer.slice(0, i)); buffer = buffer.slice(i + 1);
+    if (r.type === "get_state") out({ type: "response", id: r.id, command: "get_state", success: true, data: { sessionFile, sessionId: id, model: { provider: "p", id: "m" }, thinkingLevel: "low" } });
+    if (r.type === "switch_session") out({ type: "response", id: r.id, command: "switch_session", success: true, data: { cancelled: false } });
+    if (r.type === "prompt") {
+      fs.appendFileSync(path.join(dir, "model-calls.log"), r.message + "\\n");
+      out({ type: "response", command: "prompt", success: true });
+      out({ type: "agent_start" });
+      out({ type: "tool_execution_start", toolCallId: "t1", toolName: "bash", args: { command: "write " + process.cwd() } });
+      fs.writeFileSync("letter.txt", "Dear Amara");
+      out({ type: "tool_execution_end", toolCallId: "t1", result: { content: [{ type: "text", text: "wrote " + process.cwd() + "/letter.txt" }] } });
+      fs.writeFileSync(sessionFile, JSON.stringify({ type: "session", id, cwd: process.cwd() }) + "\\n" + JSON.stringify({ type: "message", message: { role: "user", content: r.message } }) + "\\n");
+      out({ type: "agent_end" });
+      out({ type: "agent_settled" });
+    }
+  }
+});
+`;
+
+function talk(
+  cwd: string,
+  env: NodeJS.ProcessEnv,
+  prompt: string,
+): Promise<Array<Record<string, unknown>>> {
+  return new Promise((resolve, reject) => {
+    const child = NodeChildProcess.spawn(process.execPath, [WRAPPER, "--mode", "rpc"], {
+      cwd,
+      env,
+      stdio: ["pipe", "pipe", "inherit"],
+    });
+    const records: Array<Record<string, unknown>> = [];
+    let buffer = "";
+    child.stdout.setEncoding("utf8");
+    child.stdout.on("data", (chunk: string) => {
+      buffer += chunk;
+      for (let i = buffer.indexOf("\n"); i >= 0; i = buffer.indexOf("\n")) {
+        const record = JSON.parse(buffer.slice(0, i)) as Record<string, unknown>;
+        buffer = buffer.slice(i + 1);
+        records.push(record);
+        if (record.type === "response" && record.id === "state") {
+          child.stdin.write(`${JSON.stringify({ type: "prompt", message: prompt })}\n`);
+        }
+        if (record.type === "agent_settled") {
+          child.kill();
+          resolve(records);
+        }
+      }
+    });
+    child.on("error", reject);
+    child.stdin.write(`${JSON.stringify({ id: "state", type: "get_state" })}\n`);
+  });
+}
+
+describe("hone-pi", () => {
+  it("records a first turn and replays it without the model", async () => {
+    const root = NodeFS.mkdtempSync(NodePath.join(NodeOS.tmpdir(), "hone-pi-"));
+    const sessions = NodePath.join(root, "sessions");
+    const cache = NodePath.join(root, "cache");
+    NodeFS.mkdirSync(sessions);
+    NodeFS.writeFileSync(NodePath.join(root, "fake-pi.cjs"), FAKE_PI);
+    const project = (name: string) => {
+      const dir = NodePath.join(root, name);
+      NodeFS.mkdirSync(NodePath.join(dir, "Inbox"), { recursive: true });
+      NodeFS.writeFileSync(NodePath.join(dir, "Inbox", "approval.txt"), "No bonus");
+      return dir;
+    };
+    const env = {
+      ...process.env,
+      HONE_PI_BIN: NodePath.join(root, "fake-pi.sh"),
+      HONE_TURN_CACHE_DIR: cache,
+      HONE_TURN_CACHE_MAX_GAP_MS: "10",
+      HONE_URL: "",
+      FAKE_PI_SESSIONS: sessions,
+    };
+    NodeFS.writeFileSync(
+      env.HONE_PI_BIN,
+      `#!/bin/sh\nexec "${process.execPath}" "${root}/fake-pi.cjs" "$@"\n`,
+      { mode: 0o755 },
+    );
+
+    const first = project("first");
+    await talk(first, { ...env, HONE_TURN_CACHE_RECORD: "1" }, "Write the letter.");
+    expect(NodeFS.readdirSync(cache)).toHaveLength(1);
+
+    const second = project("second");
+    const replayed = await talk(second, env, "Write the letter.");
+    const calls = NodeFS.readFileSync(NodePath.join(sessions, "model-calls.log"), "utf8");
+    expect(calls.trim().split("\n")).toEqual(["Write the letter."]);
+    expect(NodeFS.readFileSync(NodePath.join(second, "letter.txt"), "utf8")).toBe("Dear Amara");
+    const tool = replayed.find((record) => record.type === "tool_execution_end");
+    expect(JSON.stringify(tool)).toContain(`${second}/letter.txt`);
+    expect(JSON.stringify(tool)).not.toContain(first);
+
+    const notes = NodeFS.readdirSync(sessions).filter((name) => name.endsWith(".hone-replay.json"));
+    expect(notes).toHaveLength(1);
+    const session = NodePath.join(sessions, notes[0]!.replace(".hone-replay.json", ""));
+    expect(NodeFS.readFileSync(session, "utf8")).toContain(`"cwd":"${second}"`);
+
+    const third = project("third");
+    NodeFS.writeFileSync(NodePath.join(third, "Inbox", "approval.txt"), "A £3,000 bonus");
+    await talk(third, env, "Write the letter.");
+    expect(
+      NodeFS.readFileSync(NodePath.join(sessions, "model-calls.log"), "utf8").trim().split("\n"),
+    ).toHaveLength(2);
+    NodeFS.rmSync(root, { recursive: true, force: true });
+  });
+});
+
+describe("turnKey", () => {
+  it("counts an upload by name and content, not by where t3code saved it", () => {
+    const root = NodeFS.mkdtempSync(NodePath.join(NodeOS.tmpdir(), "hone-pi-key-"));
+    const saved = (name: string, text: string) => {
+      const file = NodePath.join(root, name);
+      NodeFS.writeFileSync(file, text);
+      return file;
+    };
+    const message = (path: string) => `Use this.\n\n[Attached file "a.pdf" is saved at: ${path}]`;
+    const key = (path: string) =>
+      turnKey({
+        message: message(path),
+        images: [],
+        model: null,
+        thinkingLevel: null,
+        cwd: root + "/none",
+      });
+    expect(key(saved("one", "x"))).toBe(key(saved("two", "x")));
+    expect(key(saved("three", "y"))).not.toBe(key(saved("one", "x")));
+    expect(promptAttachments(message("/a/b.pdf"))).toEqual([
+      { name: "a.pdf", path: "/a/b.pdf", extractedPath: null },
+    ]);
+    NodeFS.rmSync(root, { recursive: true, force: true });
+  });
+
+  it("rewrites paths inside JSON strings too", () => {
+    const text = JSON.stringify({ text: 'cd "/old dir"' });
+    expect(applyReplacements(text, [["/old dir", "/new dir"]])).toBe(
+      JSON.stringify({ text: 'cd "/new dir"' }),
+    );
+  });
+});
