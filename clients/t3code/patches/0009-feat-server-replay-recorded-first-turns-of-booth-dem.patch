+#!/usr/bin/env node
+// @effect-diagnostics nodeBuiltinImport:off globalDate:off globalTimers:off globalFetch:off
+// Pi for the Hone booth demo, set as Pi's binary path. It replays a recorded first turn when one
+// matches and passes everything else to the real Pi. Settings in clients/t3code/README.md (Hone).
+import * as NodeChildProcess from "node:child_process";
+import * as NodeFS from "node:fs";
+import * as NodePath from "node:path";
+
+import {
+  applyReplacements,
+  changedFiles,
+  folderSnapshot,
+  type PiModelChoice,
+  promptAttachments,
+  readRecording,
+  recordingPath,
+  replayReplacements,
+  sessionHasUserMessage,
+  TURN_RECORDING_VERSION,
+  type TurnRecording,
+  turnKey,
+} from "./hone-pi-turn-cache.ts";
+
+type PiRecord = Record<string, unknown>;
+
+const args = process.argv.slice(2);
+// The first folder takes new recordings. A replay looks in each, in order.
+const cacheDirs = (process.env.HONE_TURN_CACHE_DIR ?? "").split(NodePath.delimiter).filter(Boolean);
+const cacheDir = cacheDirs[0] ?? null;
+const recordTurns = process.env.HONE_TURN_CACHE_RECORD === "1";
+const maxGapMs = Number(process.env.HONE_TURN_CACHE_MAX_GAP_MS) || 1500;
+const rpcMode = args.some(
+  (arg, i) => arg === "--mode=rpc" || (arg === "--mode" && args[i + 1] === "rpc"),
+);
+const cwd = process.cwd();
+
+const pi = NodeChildProcess.spawn(process.env.HONE_PI_BIN || "pi", args, {
+  stdio: cacheDir !== null && rpcMode ? ["pipe", "pipe", "inherit"] : "inherit",
+});
+pi.on("exit", (code, signal) => process.exit(code ?? (signal === null ? 0 : 1)));
+pi.on("error", (error) => {
+  process.stderr.write(`hone-pi: could not start Pi: ${error.message}\n`);
+  process.exit(127);
+});
+
+const log = (text: string) => process.stderr.write(`hone-pi: ${text}\n`);
+const out = (record: PiRecord) => process.stdout.write(`${JSON.stringify(record)}\n`);
+const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
+
+/** What Pi last reported about its session, from get_state and set_* responses. */
+const piState = {
+  sessionFile: null as string | null,
+  sessionId: null as string | null,
+  model: null as PiModelChoice | null,
+  thinkingLevel: null as string | null,
+};
+
+let recorder: {
+  readonly key: string;
+  readonly prompt: string;
+  readonly startedAt: number;
+  readonly events: Array<{ at: number; record: PiRecord }>;
+  readonly files: Array<{ at: number; path: string; base64: string }>;
+  before: Map<string, string>;
+} | null = null;
+let replaying: { finishNow: boolean } | null = null;
+/** Pi output during our own switch_session is ours to read, never t3code's. */
+let ownRequest: { readonly id: string; readonly done: (record: PiRecord) => void } | null = null;
+
+function noteState(record: PiRecord) {
+  if (record.type !== "response" || record.success !== true) return;
+  const data = (record.data ?? {}) as Record<string, unknown>;
+  if (record.command === "get_state") {
+    if (typeof data.sessionFile === "string") piState.sessionFile = data.sessionFile;
+    if (typeof data.sessionId === "string") piState.sessionId = data.sessionId;
+    const model = data.model as { provider?: unknown; id?: unknown } | undefined;
+    if (typeof model?.provider === "string" && typeof model.id === "string") {
+      piState.model = { provider: model.provider, modelId: model.id };
+    }
+    if (typeof data.thinkingLevel === "string") piState.thinkingLevel = data.thinkingLevel;
+  }
+}
+
+function sniffCommand(record: PiRecord) {
+  if (
+    record.type === "set_model" &&
+    typeof record.provider === "string" &&
+    typeof record.modelId === "string"
+  ) {
+    piState.model = { provider: record.provider, modelId: record.modelId };
+  }
+  if (record.type === "set_thinking_level" && typeof record.level === "string") {
+    piState.thinkingLevel = record.level;
+  }
+}
+
+function captureFiles(at: number) {
+  if (recorder === null) return;
+  for (const file of changedFiles(cwd, recorder.before)) {
+    recorder.files.push({
+      at,
+      path: file.path,
+      base64: NodeFS.readFileSync(NodePath.join(cwd, file.path)).toString("base64"),
+    });
+  }
+  recorder.before = folderSnapshot(cwd);
+}
+
+function finishRecording() {
+  const rec = recorder;
+  recorder = null;
+  if (
+    rec === null ||
+    cacheDir === null ||
+    piState.sessionFile === null ||
+    piState.sessionId === null
+  )
+    return;
+  captureFiles(Date.now() - rec.startedAt);
+  const recording: TurnRecording = {
+    version: TURN_RECORDING_VERSION,
+    key: rec.key,
+    recordedAt: new Date().toISOString(),
+    source: {
+      sessionId: piState.sessionId,
+      sessionFile: piState.sessionFile,
+      cwd,
+      model: piState.model,
+      thinkingLevel: piState.thinkingLevel,
+    },
+    prompt: rec.prompt,
+    attachments: promptAttachments(rec.prompt),
+    events: rec.events,
+    files: rec.files,
+    session: NodeFS.readFileSync(piState.sessionFile, "utf8"),
+  };
+  NodeFS.mkdirSync(cacheDir, { recursive: true });
+  NodeFS.writeFileSync(recordingPath(cacheDir, rec.key), `${JSON.stringify(recording)}\n`);
+  log(`recorded turn ${rec.key} from session ${piState.sessionId}`);
+}
+
+function fromPi(line: string) {
+  let record: PiRecord;
+  try {
+    record = JSON.parse(line) as PiRecord;
+  } catch {
+    process.stdout.write(`${line}\n`);
+    return;
+  }
+  noteState(record);
+  if (ownRequest !== null) {
+    if (record.type === "response" && record.id === ownRequest.id) ownRequest.done(record);
+    return;
+  }
+  if (recorder !== null) {
+    const at = Date.now() - recorder.startedAt;
+    // Answers to t3code's other requests during the turn belong to those requests, not the turn.
+    if (record.type !== "response" || record.command === "prompt")
+      recorder.events.push({ at, record });
+    if (record.type === "tool_execution_end") captureFiles(at);
+    // Saved before t3code hears the turn settle, so the recording is whole once it does.
+    if (record.type === "agent_settled") finishRecording();
+  }
+  process.stdout.write(`${line}\n`);
+}
+
+function askPi(record: PiRecord): Promise<PiRecord> {
+  const id = `hone-pi-${Date.now()}`;
+  return new Promise((resolve) => {
+    ownRequest = {
+      id,
+      done: (response) => {
+        ownRequest = null;
+        resolve(response);
+      },
+    };
+    pi.stdin?.write(`${JSON.stringify({ ...record, id })}\n`);
+  });
+}
+
+/** Sends Hone the session the way the Hone Pi extension does after a reply. */
+async function publishTrace(sessionId: string, body: string) {
+  const url = (process.env.HONE_URL ?? "").replace(/\/+$/, "");
+  if (url === "") return;
+  const auth = { authorization: `Bearer ${process.env.HONE_TOKEN ?? ""}` };
+  try {
+    const agents = await fetch(`${url}/agents.md`, { headers: auth });
+    const version = agents.headers.get("x-hone-version");
+    await agents.text();
+    const res = await fetch(`${url}/api/traces/${sessionId}`, {
+      method: "PUT",
+      headers: {
+        ...auth,
+        "content-type": "application/x-ndjson",
+        ...(version ? { "x-hone-version": version } : {}),
+      },
+      body,
+    });
+    if (!res.ok) log(`Hone answered ${res.status} to the replayed trace`);
+  } catch (error) {
+    log(`could not send the replayed trace to Hone: ${String(error)}`);
+  }
+}
+
+async function replay(recording: TurnRecording, prompt: PiRecord) {
+  const sessionFile = piState.sessionFile!;
+  const sessionId = piState.sessionId!;
+  const replacements = replayReplacements(recording, {
+    sessionId,
+    sessionFile,
+    cwd,
+    attachments: promptAttachments(String(prompt.message ?? "")),
+  });
+  const rewrite = <T>(value: T): T =>
+    JSON.parse(applyReplacements(JSON.stringify(value), replacements)) as T;
+  const state = { finishNow: false };
+  replaying = state;
+  log(`replaying turn ${recording.key}, recorded ${recording.recordedAt}`);
+  let clock = 0;
+  let nextFile = 0;
+  for (const { at, record } of recording.events) {
+    if (!state.finishNow) await sleep(Math.min(Math.max(0, at - clock), maxGapMs));
+    clock = at;
+    for (; nextFile < recording.files.length && recording.files[nextFile]!.at <= at; nextFile++) {
+      const file = recording.files[nextFile]!;
+      const target = NodePath.join(cwd, file.path);
+      NodeFS.mkdirSync(NodePath.dirname(target), { recursive: true });
+      NodeFS.writeFileSync(target, Buffer.from(file.base64, "base64"));
+    }
+    if (record.type === "agent_settled") {
+      const session = applyReplacements(recording.session, replacements);
+      NodeFS.writeFileSync(sessionFile, session);
+      // Pi reloads the session, so a follow-up message continues it.
+      await askPi({ type: "switch_session", sessionPath: sessionFile });
+      await publishTrace(sessionId, session);
+      NodeFS.writeFileSync(
+        `${sessionFile}.hone-replay.json`,
+        `${JSON.stringify(
+          {
+            replayOf: recording.key,
+            recordedAt: recording.recordedAt,
+            sourceSessionId: recording.source.sessionId,
+            replayedAt: new Date().toISOString(),
+          },
+          null,
+          2,
+        )}\n`,
+      );
+    }
+    const replayed = rewrite(record);
+    if (replayed.type === "response" && replayed.command === "prompt") {
+      if (prompt.id === undefined) delete replayed.id;
+      else replayed.id = prompt.id;
+    }
+    out(replayed);
+  }
+  replaying = null;
+}
+
+function fromT3code(line: string) {
+  let record: PiRecord;
+  try {
+    record = JSON.parse(line) as PiRecord;
+  } catch {
+    pi.stdin?.write(`${line}\n`);
+    return;
+  }
+  sniffCommand(record);
+  if (replaying !== null && record.type === "abort") replaying.finishNow = true;
+  if (
+    record.type === "prompt" &&
+    cacheDir !== null &&
+    replaying === null &&
+    recorder === null &&
+    piState.sessionFile !== null &&
+    piState.sessionId !== null &&
+    !sessionHasUserMessage(piState.sessionFile)
+  ) {
+    const key = turnKey({
+      message: String(record.message ?? ""),
+      images: Array.isArray(record.images) ? record.images : [],
+      model: piState.model,
+      thinkingLevel: piState.thinkingLevel,
+      cwd,
+    });
+    const recording =
+      cacheDirs.map((dir) => readRecording(dir, key)).find((found) => found !== null) ?? null;
+    if (recording !== null) {
+      void replay(recording, record);
+      return;
+    }
+    if (recordTurns) {
+      recorder = {
+        key,
+        prompt: String(record.message ?? ""),
+        startedAt: Date.now(),
+        events: [],
+        files: [],
+        before: folderSnapshot(cwd),
+      };
+    }
+  }
+  pi.stdin?.write(`${line}\n`);
+}
+
+if (cacheDir !== null && rpcMode) {
+  // Split on LF only, as Pi frames records. readline would also split on U+2028.
+  const lines = (stream: NodeJS.ReadableStream, onLine: (line: string) => void) => {
+    let buffer = "";
+    stream.setEncoding("utf8");
+    stream.on("data", (chunk: string) => {
+      buffer += chunk;
+      let newline = buffer.indexOf("\n");
+      while (newline >= 0) {
+        const line = buffer.slice(0, newline).replace(/\r$/, "");
+        buffer = buffer.slice(newline + 1);
+        if (line !== "") onLine(line);
+        newline = buffer.indexOf("\n");
+      }
+    });
+  };
+  lines(pi.stdout!, fromPi);
+  lines(process.stdin, fromT3code);
+  process.stdin.on("end", () => pi.stdin?.end());
+}
