--- /dev/null
+++ b/apps/server/src/auth/proxyAuth.ts
@@ -0,0 +1,49 @@
+// @effect-diagnostics-next-line nodeBuiltinImport:off -- Effect's Crypto has no timingSafeEqual.
+import * as NodeCrypto from "node:crypto";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Redacted from "effect/Redacted";
+import * as HttpRouter from "effect/http/HttpRouter";
+import * as HttpServerRequest from "effect/http/HttpServerRequest";
+import * as HttpServerResponse from "effect/http/HttpServerResponse";
+
+import * as ServerConfig from "../config.ts";
+
+export const PROXY_AUTH_HEADER = "x-t3code-proxy-auth";
+
+const sha256 = (value: string) => NodeCrypto.createHash("sha256").update(value).digest();
+
+/** True when the request carries the secret the authenticating reverse proxy adds. */
+export function isProxyAuthenticated(
+  request: HttpServerRequest.HttpServerRequest,
+  secret: Redacted.Redacted<string>,
+): boolean {
+  const presented = request.headers[PROXY_AUTH_HEADER];
+  return (
+    presented !== undefined &&
+    NodeCrypto.timingSafeEqual(sha256(presented), sha256(Redacted.value(secret)))
+  );
+}
+
+// The CLI and agent MCP calls reach the server directly with a token of their own. A cookie
+// would let a browser session ride along, so only cookieless token requests skip the proxy.
+const presentsOwnToken = (request: HttpServerRequest.HttpServerRequest) =>
+  request.headers.cookie === undefined &&
+  /^(Bearer|DPoP) /i.test(request.headers.authorization ?? "");
+
+/** With a proxy secret configured, refuses every request that bypassed the proxy. */
+export const layerProxyAuthGate = Layer.unwrap(
+  Effect.gen(function* () {
+    const { proxyAuthSecret } = yield* ServerConfig.ServerConfig;
+    if (proxyAuthSecret === undefined) return Layer.empty;
+    return HttpRouter.middleware(
+      (httpEffect) =>
+        Effect.flatMap(HttpServerRequest.HttpServerRequest, (request) =>
+          isProxyAuthenticated(request, proxyAuthSecret) || presentsOwnToken(request)
+            ? httpEffect
+            : Effect.succeed(HttpServerResponse.text("Unauthorized", { status: 401 })),
+        ),
+      { global: true },
+    );
+  }),
+);
