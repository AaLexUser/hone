diff --git a/apps/server/src/auth/proxyAuth.test.ts b/apps/server/src/auth/proxyAuth.test.ts
new file mode 100644
index 00000000..4e46e897
--- /dev/null
+++ b/apps/server/src/auth/proxyAuth.test.ts
@@ -0,0 +1,178 @@
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import {
+  AuthAccessTokenType,
+  AuthEnvironmentBootstrapTokenType,
+  AuthTokenExchangeGrantType,
+  EnvironmentHttpApi,
+} from "@t3tools/contracts";
+import { describe, expect, it } from "@effect/vitest";
+import * as Context from "effect/Context";
+import * as Crypto from "effect/Crypto";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Redacted from "effect/Redacted";
+import * as Etag from "effect/http/Etag";
+import * as HttpPlatform from "effect/http/HttpPlatform";
+import * as HttpRouter from "effect/http/HttpRouter";
+import * as HttpApi from "effect/http-api/HttpApi";
+import * as HttpApiBuilder from "effect/http-api/HttpApiBuilder";
+
+import * as ServerConfig from "../config.ts";
+import * as ServerEnvironment from "../environment/ServerEnvironment.ts";
+import * as SqlitePersistence from "../persistence/Sqlite.ts";
+import * as ManagedPolicy from "../policy/ManagedPolicy.ts";
+import * as EnvironmentAuth from "./EnvironmentAuth.ts";
+import * as AuthHttp from "./http.ts";
+import * as ProxyAuth from "./proxyAuth.ts";
+import * as ServerSecretStore from "./ServerSecretStore.ts";
+
+const SECRET = "booth-proxy-secret";
+class AuthTestApi extends HttpApi.make("environment").add(EnvironmentHttpApi.groups.auth) {}
+
+const makeHandler = (proxyAuthSecret: string | undefined) => {
+  const layerConfig = Layer.effect(
+    ServerConfig.ServerConfig,
+    Effect.gen(function* () {
+      const config = yield* ServerConfig.ServerConfig;
+      return {
+        ...config,
+        mode: "web",
+        host: "0.0.0.0",
+        ...(proxyAuthSecret === undefined
+          ? {}
+          : { proxyAuthSecret: Redacted.make(proxyAuthSecret) }),
+      } satisfies ServerConfig.ServerConfig["Service"];
+    }),
+  ).pipe(Layer.provide(ServerConfig.layerTest(process.cwd(), { prefix: "t3-proxy-auth-test-" })));
+  const layerRoutes = HttpApiBuilder.layer(AuthTestApi).pipe(
+    Layer.provide(AuthHttp.layer),
+    Layer.provide(AuthHttp.layerAuthenticatedAuth),
+    Layer.provideMerge(
+      EnvironmentAuth.layer.pipe(
+        Layer.provide(ManagedPolicy.layerTest()),
+        Layer.provide(SqlitePersistence.layerMemory),
+        Layer.provide(ServerSecretStore.layer),
+        Layer.provide(ServerEnvironment.layerIdentity),
+      ),
+    ),
+    Layer.merge(ProxyAuth.layerProxyAuthGate),
+    Layer.provide(layerConfig),
+    Layer.provideMerge(
+      HttpPlatform.layer.pipe(
+        Layer.provideMerge(NodeServices.layer),
+        Layer.provideMerge(Etag.layerWeak),
+      ),
+    ),
+    Layer.provide(NodeServices.layer),
+  );
+  return HttpRouter.toWebHandler(layerRoutes, { disableLogger: true });
+};
+
+const withHandler = (
+  proxyAuthSecret: string | undefined,
+  run: (send: (path: string, init?: RequestInit) => Promise<Response>) => Promise<void>,
+) =>
+  Effect.gen(function* () {
+    const crypto = yield* Crypto.Crypto;
+    const requestContext = Context.make(Crypto.Crypto, crypto).pipe(
+      Context.add(
+        ServerSecretStore.ServerSecretStore,
+        ServerSecretStore.ServerSecretStore.of({
+          get: () => Effect.succeedNone,
+          set: () => Effect.void,
+          create: () => Effect.void,
+          getOrCreateRandom: () => Effect.die("Not used by these routes."),
+          remove: () => Effect.void,
+        }),
+      ),
+    );
+    return yield* Effect.acquireUseRelease(
+      Effect.sync(() => makeHandler(proxyAuthSecret)),
+      (environment) =>
+        Effect.promise(() =>
+          run((path, init) =>
+            environment.handler(new Request(`http://127.0.0.1${path}`, init), requestContext),
+          ),
+        ),
+      (environment) => Effect.promise(() => environment.dispose()),
+    );
+  }).pipe(Effect.provide(NodeServices.layer));
+
+const proxied = { [ProxyAuth.PROXY_AUTH_HEADER]: SECRET };
+const postJson = (body: unknown, headers: Record<string, string>): RequestInit => ({
+  method: "POST",
+  headers: { "content-type": "application/json", ...headers },
+  body: JSON.stringify(body),
+});
+
+describe("proxy auth", () => {
+  it.effect("signs in every proxied browser and refuses requests that bypass the proxy", () =>
+    withHandler(SECRET, async (send) => {
+      expect((await send("/api/auth/session")).status).toBe(401);
+      expect(
+        (await send("/api/auth/session", { headers: { [ProxyAuth.PROXY_AUTH_HEADER]: "wrong" } }))
+          .status,
+      ).toBe(401);
+
+      const signedIn = await send("/api/auth/session", { headers: proxied });
+      expect(signedIn.status).toBe(200);
+      expect(await signedIn.json()).toMatchObject({
+        authenticated: true,
+        sessionMethod: "browser-session-cookie",
+      });
+      const cookie = signedIn.headers.getSetCookie()[0]?.split(";", 1)[0] ?? "";
+      expect(cookie).toMatch(/^t3_session_\w+=.+/);
+
+      const again = await send("/api/auth/session", { headers: { ...proxied, cookie } });
+      expect(await again.json()).toMatchObject({ authenticated: true });
+      expect(again.headers.getSetCookie()).toEqual([]);
+
+      const ticket = await send("/api/auth/websocket-ticket", {
+        method: "POST",
+        headers: { ...proxied, cookie },
+      });
+      expect(ticket.status).toBe(200);
+      expect(
+        (await send("/api/auth/websocket-ticket", { method: "POST", headers: { cookie } })).status,
+      ).toBe(401);
+
+      const pairing = await send(
+        "/api/auth/pairing-token",
+        postJson({ scopes: ["orchestration:read"] }, { ...proxied, cookie }),
+      );
+      const { credential } = (await pairing.json()) as { credential: string };
+      const exchanged = await send("/oauth/token", {
+        method: "POST",
+        headers: proxied,
+        body: new URLSearchParams({
+          grant_type: AuthTokenExchangeGrantType,
+          subject_token: credential,
+          subject_token_type: AuthEnvironmentBootstrapTokenType,
+          requested_token_type: AuthAccessTokenType,
+        }),
+      });
+      const { access_token } = (await exchanged.json()) as { access_token: string };
+      const bearer = { authorization: `Bearer ${access_token}` };
+      expect(
+        (await send("/api/auth/websocket-ticket", { method: "POST", headers: bearer })).status,
+      ).toBe(200);
+      expect(
+        (
+          await send("/api/auth/websocket-ticket", {
+            method: "POST",
+            headers: { ...bearer, cookie },
+          })
+        ).status,
+      ).toBe(401);
+    }),
+  );
+
+  it.effect("leaves sign-in to pairing when no proxy secret is configured", () =>
+    withHandler(undefined, async (send) => {
+      const session = await send("/api/auth/session", { headers: proxied });
+      expect(session.status).toBe(200);
+      expect(await session.json()).toMatchObject({ authenticated: false });
+      expect(session.headers.getSetCookie()).toEqual([]);
+    }),
+  );
+});
