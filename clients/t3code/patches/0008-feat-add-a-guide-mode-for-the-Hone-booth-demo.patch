+// The messages the Hone dashboard posts to t3code when it runs in the Hone page's frame
+// (Hone's apps/web/src/lib/embed.ts), and the outline requests t3code posts back.
+
+export type HoneFrameEvent =
+  | { readonly type: "route"; readonly path: string }
+  | { readonly type: "start-pressed" }
+  | { readonly type: "run-started"; readonly runId: string; readonly quick: boolean }
+  | { readonly type: "run-finished"; readonly runId: string; readonly status: string }
+  | { readonly type: "activity" };
+
+let frame: HTMLIFrameElement | null = null;
+let frameOrigin: string | null = null;
+let highlight: string | null = null;
+
+/** The Hone page registers its frame, so the guide can tell it what to outline. */
+export function registerHoneFrame(element: HTMLIFrameElement | null, src: string | null): void {
+  frame = element;
+  frameOrigin = element === null || src === null ? null : originOf(src);
+  sendHighlight();
+}
+
+function originOf(src: string): string | null {
+  try {
+    return new URL(src, window.location.href).origin;
+  } catch {
+    return null;
+  }
+}
+
+/** Asks the Hone frame to outline the control marked `data-guide="<name>"`, or nothing. */
+export function setHoneFrameHighlight(name: string | null): void {
+  highlight = name;
+  sendHighlight();
+}
+
+/** Called again once the frame has loaded, since a page that was not there yet missed it. */
+export function sendHighlight(): void {
+  if (frame?.contentWindow == null || frameOrigin === null) return;
+  frame.contentWindow.postMessage({ source: "hone-guide", highlight }, frameOrigin);
+}
+
+/** A message from the registered Hone frame, or null for anything else. */
+export function parseHoneFrameMessage(event: {
+  readonly origin: string;
+  readonly source: unknown;
+  readonly data: unknown;
+}): HoneFrameEvent | null {
+  if (frame === null || frameOrigin === null) return null;
+  if (event.origin !== frameOrigin || event.source !== frame.contentWindow) return null;
+  return parseHoneFrameData(event.data);
+}
+
+export function parseHoneFrameData(data: unknown): HoneFrameEvent | null {
+  if (typeof data !== "object" || data === null) return null;
+  const message = data as Record<string, unknown>;
+  if (message.source !== "hone") return null;
+  switch (message.type) {
+    case "route":
+      return typeof message.path === "string" ? { type: "route", path: message.path } : null;
+    case "start-pressed":
+    case "activity":
+      return { type: message.type };
+    case "run-started":
+      return typeof message.runId === "string"
+        ? { type: "run-started", runId: message.runId, quick: message.quick === true }
+        : null;
+    case "run-finished":
+      return typeof message.runId === "string"
+        ? {
+            type: "run-finished",
+            runId: message.runId,
+            status: typeof message.status === "string" ? message.status : "unknown",
+          }
+        : null;
+    default:
+      return null;
+  }
+}
