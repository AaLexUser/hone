+import { observeResize } from "~/lib/observeResize";
+import { useThreadRouteTarget } from "~/hooks/useThreadRouteTarget";
+import { useRightPanelStore } from "~/rightPanelStore";
+import { usePrimaryEnvironmentId } from "~/state/environments";
+import { useEnvironmentThread } from "~/state/threads";
+import { useHoneDemoReset, useHoneStatus } from "../../chat/HoneControls";
+import { Button } from "../../ui/button";
+import { QRCodeSvg } from "../../ui/qr-code";
+import {
+  GUIDE_STEPS,
+  type GuideFacts,
+  type GuideSignal,
+  type GuideStep,
+  guideFactsKey,
+  settledStep,
+} from "./guideSteps";
+import { useGuideStore } from "./guideStore";
+import { type GuideStepText, guideText } from "./guideText";
+import { parseHoneFrameMessage, sendHighlight, setHoneFrameHighlight } from "./honeFrame";
+
+const REPO_URL = "https://github.com/AaLexUser/hone";
+const VISITOR_FILES = {
+  approval: "Inbox/Hiring approval Amara Osei.pdf",
+  template: "Inbox/Offer letter template.docx",
+};
+const RUNNING = new Set(["preparing", "queued", "starting", "running"]);
+const ACTIVITY_EVENTS = ["pointerdown", "pointermove", "keydown", "wheel", "touchstart"] as const;
+/** Steps between the welcome and closing cards, the ones the progress counts. */
+const COUNTED_STEPS = GUIDE_STEPS.length - 2;
+
+/** The booth guide. Shown over the chat routes while guide mode is on in the booth demo. */
+export function GuideLayer() {
+  const on = useGuideStore((state) => state.on);
+  const unlocking = useGuideStore((state) => state.unlocking);
+  const status = useHoneStatus(usePrimaryEnvironmentId());
+  if (!on || unlocking || status?.demo !== true) return null;
+  return <ActiveGuide config={status.guide} />;
+}
+
+function ActiveGuide({ config }: { readonly config: HoneGuideConfig }) {
+  const step = useGuideStore((state) => state.step);
+  const signals = useGuideStore((state) => state.signals);
+  const runQuick = useGuideStore((state) => state.runQuick);
+  const runFailed = useGuideStore((state) => state.runFailed);
+  const visitorChat = useGuideStore((state) => state.visitorChat);
+  const signalSet = new Set<GuideSignal>(signals);
+  const facts = useGuideFacts(visitorChat);
+  const factsKey = guideFactsKey(facts, signalSet);
+  const current = GUIDE_STEPS[step]!;
+  const [video, setVideo] = useState(false);
+  const [resetting, setResetting] = useState(false);
+  const startOver = useStartOver(setResetting);
+
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- the guide moves on when the real event its step waits for has happened
+  useEffect(() => {
+    const store = useGuideStore.getState();
+    if (store.heldAt !== null && store.heldAt === factsKey) return;
+    const next = settledStep(store.step, facts, signalSet);
+    if (next !== store.step || store.heldAt !== null) store.goTo(next);
+    // oxlint-disable-next-line react/exhaustive-effect-dependencies -- factsKey serializes facts and signals, which are new objects every render
+  }, [factsKey]);
+
+  useVisitorChatLatch(current);
+  usePrefilledRequest(current);
+  useFrameEvents();
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- tells the Hone frame which control to outline for this step
+  useEffect(() => {
+    setHoneFrameHighlight(current.target?.kind === "frame" ? current.target.highlight : null);
+  }, [current]);
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- clears the Hone frame's outline when the guide closes
+  useEffect(() => () => setHoneFrameHighlight(null), []);
+
+  const busy = current.busy?.(facts, signalSet) ?? false;
+  useIdle({
+    config,
+    busy,
+    dirty: step > 0 || signals.length > 0,
+    onVideo: () => setVideo(true),
+    onActive: () => setVideo(false),
+    onReset: startOver,
+  });
+
+  const text =
+    current.id === "watch" && runQuick === false
+      ? guideText.watchLong
+      : current.id === "start" && runFailed
+        ? guideText.startAgain
+        : guideText.steps[current.id];
+  const rect = useTargetRect(current);
+
+  return (
+    <>
+      {rect !== null && !video ? <Spotlight rect={rect} /> : null}
+      {current.id === "welcome" ? (
+        <WelcomeCard
+          text={text}
+          resetting={resetting}
+          onStart={() => useGuideStore.getState().signal("started")}
+        />
+      ) : current.id === "done" ? (
+        <ClosingCard text={text} resetting={resetting} onStartOver={() => void startOver()} />
+      ) : (
+        <StepCard
+          rect={rect}
+          index={step}
+          text={text}
+          onBack={() => useGuideStore.getState().goTo(step - 1, factsKey)}
+          onSkip={() => useGuideStore.getState().goTo(step + 1, factsKey)}
+          {...(current.id === "watch" && runQuick === false && config.videoUrl !== null
+            ? { onVideo: () => setVideo(true) }
+            : {})}
+        />
+      )}
+      {video && config.videoUrl !== null ? (
+        <BoothVideo src={config.videoUrl} onDismiss={() => setVideo(false)} />
+      ) : null}
+    </>
+  );
+}
+
+function useGuideFacts(visitorChat: string | null): GuideFacts {
+  const pathname = useLocation({ select: (location) => location.pathname });
+  const target = useThreadRouteTarget();
+  const visitorRef = visitorChat === null ? null : parseScopedThreadKey(visitorChat);
+  const visitorState = useEnvironmentThread(
+    visitorRef?.environmentId ?? null,
+    visitorRef?.threadId ?? null,
+  );
+  const projection = Option.getOrNull(visitorState.data);
+  const currentKey = target?.kind === "server" ? scopedThreadKey(target.threadRef) : null;
+  const openFile = useRightPanelStore((state) => {
+    const panel = currentKey === null ? undefined : state.byThreadKey[currentKey];
+    const active = panel?.isOpen === true ? panel.activeSurfaceId : null;
+    return active?.startsWith("file:") ? active.slice("file:".length) : null;
+  });
+  const sent = projection?.turnItems.some((item) => item.type === "user_message") ?? false;
+  const replied = projection?.turnItems.some((item) => item.type === "assistant_message") ?? false;
+  const running = projection?.runs.some((run) => RUNNING.has(run.status)) ?? false;
+  const page: GuideFacts["page"] =
+    pathname === "/hone"
+      ? "hone"
+      : target?.kind === "draft"
+        ? "draft"
+        : target?.kind === "server"
+          ? "thread"
+          : pathname === "/"
+            ? "home"
+            : "other";
+  return {
+    page,
+    visitorChat: visitorChat === null ? null : { sent, replied, running },
+    onVisitorChat: currentKey !== null && currentKey === visitorChat,
+    openFile,
+  };
+}
+
+/** A draft becomes a chat when the visitor sends it, which is how the guide knows their chat. */
+function useVisitorChatLatch(current: GuideStep) {
+  const target = useThreadRouteTarget();
+  const previousKind = useRef(target?.kind ?? null);
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- remembers the chat a sent draft turned into
+  useEffect(() => {
+    const was = previousKind.current;
+    previousKind.current = target?.kind ?? null;
+    if (target?.kind !== "server" || was !== "draft") return;
+    if (current.id !== "new-chat" && current.id !== "send") return;
+    useGuideStore.getState().setVisitorChat(scopedThreadKey(target.threadRef));
+  }, [target, current.id]);
+}
+
+/** Writes the request into the new chat, word for word the one the recorded chat sent. */
+function usePrefilledRequest(current: GuideStep) {
+  const target = useThreadRouteTarget();
+  const filled = useRef<string | null>(null);
+  const draftId = target?.kind === "draft" ? target.draftId : null;
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- fills the visitor's new chat once, when the guide asks them to send it
+  useEffect(() => {
+    if (current.id !== "send" || draftId === null || filled.current === draftId) return;
+    filled.current = draftId;
+    useComposerDraftStore.getState().setPrompt(
+      draftId,
+      guideText.prompt({
+        approval: serializeComposerFileLink(VISITOR_FILES.approval),
+        template: serializeComposerFileLink(VISITOR_FILES.template),
+      }),
+    );
+  }, [current.id, draftId]);
+}
+
+function useFrameEvents() {
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- listens to the Hone frame's messages while the guide is shown
+  useEffect(() => {
+    const onMessage = (event: MessageEvent) => {
+      const message = parseHoneFrameMessage(event);
+      if (message === null) return;
+      const store = useGuideStore.getState();
+      switch (message.type) {
+        case "route":
+          // A page that just loaded missed the outline request.
+          sendHighlight();
+          if (message.path.replace(/\/+$/, "").endsWith("/versions")) store.signal("versions-open");
+          return;
+        case "run-started":
+          store.setRunQuick(message.quick);
+          store.signal("run-started");
+          return;
+        case "run-finished":
+          if (message.status === "failed") store.failRun();
+          else store.signal("run-finished");
+          return;
+        case "start-pressed":
+        case "activity":
+          window.dispatchEvent(new Event("hone-guide-activity"));
+          return;
+      }
+    };
+    window.addEventListener("message", onMessage);
+    return () => window.removeEventListener("message", onMessage);
+  }, []);
+}
+
+/** Plays the booth video after a short idle and starts the demo over after a long one. */
+function useIdle(input: {
+  readonly config: HoneGuideConfig;
+  readonly busy: boolean;
+  readonly dirty: boolean;
+  readonly onVideo: () => void;
+  readonly onActive: () => void;
+  readonly onReset: () => Promise<void>;
+}) {
+  const latest = useRef(input);
+  const lastActive = useRef(0);
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- the idle timer below reads the latest settings without restarting
+  useEffect(() => {
+    latest.current = input;
+  });
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- window activity listeners and the idle timer, held while the guide is shown
+  useEffect(() => {
+    lastActive.current = Date.now();
+    const mark = (event: Event) => {
+      lastActive.current = Date.now();
+      // A tap on the video ends it on its click, so the tap never lands on the chat below.
+      const onVideo = event.target instanceof Element && event.target.closest("[data-guide-video]");
+      if (onVideo && (event.type === "pointerdown" || event.type === "touchstart")) return;
+      latest.current.onActive();
+    };
+    for (const name of ACTIVITY_EVENTS) {
+      window.addEventListener(name, mark, { capture: true, passive: true });
+    }
+    window.addEventListener("hone-guide-activity", mark);
+    const timer = window.setInterval(() => {
+      const { config, busy, dirty, onVideo, onReset } = latest.current;
+      if (busy) lastActive.current = Date.now();
+      const idle = Date.now() - lastActive.current;
+      if (config.videoUrl !== null && config.idleVideoSeconds > 0) {
+        if (idle >= config.idleVideoSeconds * 1000) onVideo();
+      }
+      if (dirty && config.idleResetSeconds > 0 && idle >= config.idleResetSeconds * 1000) {
+        void onReset();
+      }
+    }, 1000);
+    return () => {
+      for (const name of ACTIVITY_EVENTS) window.removeEventListener(name, mark, { capture: true });
+      window.removeEventListener("hone-guide-activity", mark);
+      window.clearInterval(timer);
+    };
+  }, []);
+}
+
+function useStartOver(setResetting: (resetting: boolean) => void) {
+  const resetDemo = useHoneDemoReset(usePrimaryEnvironmentId());
+  const running = useRef(false);
+  return async () => {
+    if (running.current) return;
+    running.current = true;
+    setResetting(true);
+    const reset = await resetDemo({ confirm: false });
+    running.current = false;
+    setResetting(false);
+    if (reset) useGuideStore.getState().restart();
+  };
+}
+
+/** Where the target is on screen, followed as the layout moves. */
+function useTargetRect(step: GuideStep): DOMRect | null {
+  const [rect, setRect] = useState<{ readonly step: GuideStep; readonly box: DOMRect } | null>(
+    null,
+  );
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- follows the target element's place in the DOM while its step is shown
+  useEffect(() => {
+    const target = step.target;
+    if (target?.kind !== "page") return;
+    let shown = "";
+    const measure = () => {
+      const candidates = [...document.querySelectorAll<HTMLElement>(target.selector)].filter(
+        (element) =>
+          (target.text === undefined || element.textContent?.includes(target.text) === true) &&
+          element.getClientRects().length > 0,
+      );
+      const box = candidates.at(-1)?.getBoundingClientRect() ?? null;
+      const key = box === null ? "" : `${box.x},${box.y},${box.width},${box.height}`;
+      if (key === shown) return;
+      shown = key;
+      setRect(box === null ? null : { step, box });
+    };
+    const first = window.requestAnimationFrame(measure);
+    const timer = window.setInterval(measure, 250);
+    return () => {
+      window.cancelAnimationFrame(first);
+      window.clearInterval(timer);
+    };
+  }, [step]);
+  return rect?.step === step ? rect.box : null;
+}
+
+function Spotlight({ rect }: { readonly rect: DOMRect }) {
+  const pad = 4;
+  return (
+    <div
+      aria-hidden
+      className="pointer-events-none fixed z-[60] animate-pulse rounded-lg ring-2 ring-primary ring-offset-2 ring-offset-background transition-all duration-300 motion-reduce:animate-none motion-reduce:transition-none"
+      style={{
+        left: rect.left - pad,
+        top: rect.top - pad,
+        width: rect.width + pad * 2,
+        height: rect.height + pad * 2,
+      }}
+    />
+  );
+}
+
+const CARD_WIDTH = 320;
+const GAP = 16;
+
+function cardPosition(rect: DOMRect | null, height: number): CSSProperties {
+  const vw = window.innerWidth;
+  const vh = window.innerHeight;
+  if (rect === null) return { right: GAP, bottom: GAP };
+  const top = Math.min(Math.max(GAP, rect.top + rect.height / 2 - height / 2), vh - height - GAP);
+  if (rect.right + GAP + CARD_WIDTH + GAP <= vw) return { left: rect.right + GAP, top };
+  if (rect.left - GAP - CARD_WIDTH >= GAP) return { left: rect.left - GAP - CARD_WIDTH, top };
+  const left = Math.min(Math.max(GAP, rect.left), vw - CARD_WIDTH - GAP);
+  return rect.top > vh / 2
+    ? { left, top: Math.max(GAP, rect.top - GAP - height) }
+    : { left, top: Math.min(rect.bottom + GAP, vh - height - GAP) };
+}
+
+function StepCard(props: {
+  readonly rect: DOMRect | null;
+  readonly index: number;
+  readonly text: GuideStepText;
+  readonly onBack: () => void;
+  readonly onSkip: () => void;
+  readonly onVideo?: () => void;
+}) {
+  const card = useRef<HTMLDivElement>(null);
+  const [height, setHeight] = useState(200);
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- keeps the card's measured height, which places it beside its target
+  useEffect(() => {
+    const element = card.current;
+    if (element === null) return;
+    return observeResize(element, () => setHeight(element.offsetHeight));
+  }, []);
+  return (
+    <div
+      ref={card}
+      role="dialog"
+      aria-label={props.text.title}
+      data-guide-card=""
+      className="fixed z-[70] flex flex-col gap-2 rounded-xl border bg-popover p-4 text-popover-foreground shadow-lg/10 transition-[left,top] duration-300 motion-reduce:transition-none"
+      style={{ width: CARD_WIDTH, ...cardPosition(props.rect, height) }}
+    >
+      <div className="flex items-center gap-2 text-muted-foreground text-xs">
+        <span className="tabular-nums">{guideText.progress(props.index, COUNTED_STEPS)}</span>
+        <div className="h-1 flex-1 overflow-hidden rounded-full bg-muted">
+          <div
+            className="h-full rounded-full bg-primary transition-[width] duration-300"
+            style={{ width: `${(props.index / COUNTED_STEPS) * 100}%` }}
+          />
+        </div>
+      </div>
+      <h2 className="font-medium text-sm">{props.text.title}</h2>
+      <p className="text-sm">{props.text.body}</p>
+      {props.text.next ? <p className="text-muted-foreground text-xs">{props.text.next}</p> : null}
+      <div className="mt-1 flex items-center gap-1">
+        <Button size="xs" variant="ghost" onClick={props.onBack}>
+          {guideText.back}
+        </Button>
+        <Button size="xs" variant="ghost" onClick={props.onSkip}>
+          {guideText.skip}
+        </Button>
+        {props.onVideo ? (
+          <Button size="xs" variant="outline" className="ms-auto" onClick={props.onVideo}>
+            {guideText.watchVideo}
+          </Button>
+        ) : null}
+      </div>
+    </div>
+  );
+}
+
+/** The welcome card sits over a dimmed screen. Clicks still pass, so the presenter can leave guide mode. */
+function WelcomeCard(props: {
+  readonly text: GuideStepText;
+  readonly resetting: boolean;
+  readonly onStart: () => void;
+}) {
+  return (
+    <div className="pointer-events-none fixed inset-0 z-[70] grid place-items-center bg-black/30 p-4">
+      <div
+        role="dialog"
+        aria-label={props.text.title}
+        data-guide-card=""
+        className="pointer-events-auto flex w-full max-w-md flex-col gap-3 rounded-2xl border bg-popover p-6 text-popover-foreground shadow-xl/10"
+      >
+        <h2 className="font-semibold text-xl">{props.text.title}</h2>
+        <p className="text-sm">{props.text.body}</p>
+        {props.text.next ? (
+          <p className="text-muted-foreground text-sm">{props.text.next}</p>
+        ) : null}
+        <div className="mt-2 flex justify-end">
+          <Button disabled={props.resetting} onClick={props.onStart}>
+            {props.resetting ? guideText.resetting : guideText.start}
+          </Button>
+        </div>
+      </div>
+    </div>
+  );
+}
+
+/** The closing card leaves the new AGENTS.md version in view. */
+function ClosingCard(props: {
+  readonly text: GuideStepText;
+  readonly resetting: boolean;
+  readonly onStartOver: () => void;
+}) {
+  return (
+    <div
+      role="dialog"
+      aria-label={props.text.title}
+      data-guide-card=""
+      className="fixed right-4 bottom-4 z-[70] flex w-96 flex-col gap-3 rounded-xl border bg-popover p-4 text-popover-foreground shadow-lg/10"
+    >
+      <h2 className="font-semibold text-base">{props.text.title}</h2>
+      <p className="text-sm">{props.text.body}</p>
+      <div className="flex items-center gap-4">
+        <QRCodeSvg value={REPO_URL} size={104} title={guideText.codeLabel} />
+        <div className="flex flex-col gap-1 text-sm">
+          {props.text.next ? (
+            <span className="text-muted-foreground">{props.text.next}</span>
+          ) : null}
+          <span className="font-medium">{guideText.codeLabel}</span>
+          <span className="text-muted-foreground">{guideText.paper}</span>
+        </div>
+      </div>
+      <div className="flex justify-end">
+        <Button disabled={props.resetting} onClick={props.onStartOver}>
+          {props.resetting ? guideText.resetting : guideText.startOver}
+        </Button>
+      </div>
+    </div>
+  );
+}
+
+function BoothVideo({ src, onDismiss }: { readonly src: string; readonly onDismiss: () => void }) {
+  return (
+    <div
+      role="button"
+      tabIndex={-1}
+      aria-label={guideText.videoHint}
+      data-guide-video=""
+      className="fixed inset-0 z-[100] bg-black"
+      onClick={onDismiss}
+    >
+      <video src={src} autoPlay muted loop playsInline className="size-full object-contain" />
+      <p className="pointer-events-none absolute inset-x-0 bottom-8 text-center text-sm text-white/80">
+        {guideText.videoHint}
+      </p>
+    </div>
+  );
+}
