new file mode 100644
index 00000000..a12d8d7b
--- /dev/null
+++ b/apps/web/src/components/hone/guide/GuideToggle.tsx
@@ -0,0 +1,141 @@
+import type { EnvironmentId } from "@t3tools/contracts";
+import { SignpostIcon } from "lucide-react";
+import { useRef, useState } from "react";
+
+import { cn } from "~/lib/utils";
+import { honeEnvironment } from "~/state/hone";
+import { useAtomCommand } from "~/state/use-atom-command";
+import { useHoneStatus } from "../../chat/HoneControls";
+import { Button } from "../../ui/button";
+import { Input } from "../../ui/input";
+import {
+  Dialog,
+  DialogFooter,
+  DialogHeader,
+  DialogPanel,
+  DialogPopup,
+  DialogTitle,
+} from "../../ui/dialog";
+import { SidebarMenuButton, SidebarMenuItem } from "../../ui/sidebar";
+import { Tooltip, TooltipPopup, TooltipTrigger } from "../../ui/tooltip";
+import { useGuideStore } from "./guideStore";
+import { guideText } from "./guideText";
+
+const HOLD_MS = 2000;
+
+/**
+ * Turns guide mode on with a click. Turning it off takes a two second hold, then the PIN when
+ * HONE_GUIDE_PIN is set, so a visitor cannot leave the guide by accident.
+ */
+export function GuideToggle({ environmentId }: { readonly environmentId: EnvironmentId | null }) {
+  const on = useGuideStore((state) => state.on);
+  const status = useHoneStatus(environmentId);
+  const unlock = useAtomCommand(honeEnvironment.guideUnlock, { reportFailure: false });
+  const [holding, setHolding] = useState(false);
+  const pinOpen = useGuideStore((state) => state.unlocking);
+  const setPinOpen = useGuideStore((state) => state.setUnlocking);
+  const [pin, setPin] = useState("");
+  const [wrong, setWrong] = useState(false);
+  const timer = useRef<number | null>(null);
+
+  const cancelHold = () => {
+    if (timer.current !== null) window.clearTimeout(timer.current);
+    timer.current = null;
+    setHolding(false);
+  };
+  const startHold = () => {
+    cancelHold();
+    setHolding(true);
+    timer.current = window.setTimeout(() => {
+      timer.current = null;
+      setHolding(false);
+      if (status?.guide.exitPin === true) {
+        setPin("");
+        setWrong(false);
+        setPinOpen(true);
+      } else {
+        useGuideStore.getState().exit();
+      }
+    }, HOLD_MS);
+  };
+  const submitPin = async () => {
+    if (environmentId === null) return;
+    const result = await unlock({ environmentId, input: { pin } });
+    if (result._tag === "Success" && result.value.unlocked) {
+      useGuideStore.getState().exit();
+      return;
+    }
+    setWrong(true);
+  };
+
+  const label = on ? guideText.holdToExit : guideText.guideOn;
+  return (
+    <SidebarMenuItem className="shrink-0">
+      <Tooltip>
+        <TooltipTrigger
+          render={
+            <SidebarMenuButton
+              aria-label={label}
+              aria-pressed={on}
+              size="icon"
+              data-guide-toggle=""
+              isActive={on}
+              className="relative overflow-hidden"
+              onClick={on ? undefined : () => useGuideStore.getState().enter()}
+              onPointerDown={on ? startHold : undefined}
+              onPointerUp={cancelHold}
+              onPointerLeave={cancelHold}
+              onPointerCancel={cancelHold}
+            />
+          }
+        >
+          <SignpostIcon />
+          {on ? (
+            <span
+              aria-hidden
+              className={cn(
+                "absolute inset-x-0 bottom-0 h-0.5 bg-primary",
+                holding ? "w-full transition-[width] ease-linear" : "w-0",
+              )}
+              style={holding ? { transitionDuration: `${HOLD_MS}ms` } : undefined}
+            />
+          ) : null}
+        </TooltipTrigger>
+        <TooltipPopup side="top">{label}</TooltipPopup>
+      </Tooltip>
+      <Dialog open={pinOpen} onOpenChange={setPinOpen}>
+        <DialogPopup className="sm:max-w-xs" showCloseButton={false}>
+          <form
+            className="flex min-h-0 flex-col"
+            onSubmit={(event) => {
+              event.preventDefault();
+              void submitPin();
+            }}
+          >
+            <DialogHeader>
+              <DialogTitle>{guideText.pinTitle}</DialogTitle>
+            </DialogHeader>
+            <DialogPanel>
+              <Input
+                autoFocus
+                type="password"
+                inputMode="numeric"
+                autoComplete="off"
+                aria-label={guideText.pinTitle}
+                value={pin}
+                onChange={(event) => {
+                  setPin(event.target.value);
+                  setWrong(false);
+                }}
+              />
+              {wrong ? <p className="mt-2 text-destructive text-xs">{guideText.pinWrong}</p> : null}
+            </DialogPanel>
+            <DialogFooter>
+              <Button type="submit">{guideText.pinSubmit}</Button>
+            </DialogFooter>
+          </form>
+        </DialogPopup>
+      </Dialog>
+    </SidebarMenuItem>
+  );
+}
diff --git a/apps/web/src/components/hone/guide/guideSteps.test.ts b/apps/web/src/components/hone/guide/guideSteps.test.ts
new file mode 100644
index 00000000..0c506281
--- /dev/null
+++ b/apps/web/src/components/hone/guide/guideSteps.test.ts
@@ -0,0 +1,92 @@
+import { describe, expect, it } from "vite-plus/test";
+
+import { GUIDE_STEPS, type GuideFacts, type GuideSignal, settledStep } from "./guideSteps";
+import { GUIDE_STRINGS } from "./guideText";
+import { parseHoneFrameData } from "./honeFrame";
+
+const idle: GuideFacts = { page: "draft", visitorChat: null, onVisitorChat: false, openFile: null };
+const at = (id: string) => GUIDE_STEPS.findIndex((step) => step.id === id);
+const signals = (...names: GuideSignal[]) => new Set(names);
+
+describe("settledStep", () => {
+  it("waits on the welcome card until the visitor starts", () => {
+    expect(settledStep(0, idle, signals())).toBe(0);
+    expect(settledStep(0, idle, signals("started"))).toBe(at("open-past-chat"));
+  });
+
+  it("moves on only when the real event happened", () => {
+    const onPastChat = { ...idle, page: "thread" as const };
+    expect(settledStep(at("open-past-chat"), onPastChat, signals())).toBe(at("read-feedback"));
+    expect(settledStep(at("read-feedback"), onPastChat, signals("feedback-expanded"))).toBe(
+      at("new-chat"),
+    );
+  });
+
+  it("follows the visitor's chat from sent to replied", () => {
+    const working = {
+      ...idle,
+      page: "thread" as const,
+      onVisitorChat: true,
+      visitorChat: { sent: true, replied: false, running: true },
+    };
+    expect(settledStep(at("send"), working, signals())).toBe(at("working"));
+    expect(GUIDE_STEPS[at("working")]!.busy?.(working, signals())).toBe(true);
+    const replied = { ...working, visitorChat: { sent: true, replied: true, running: false } };
+    expect(settledStep(at("working"), replied, signals())).toBe(at("open-letter"));
+    expect(
+      settledStep(at("open-letter"), { ...replied, openFile: "Offer_Osei_Amara.pdf" }, signals()),
+    ).toBe(at("thumbs-down"));
+    expect(
+      settledStep(at("open-letter"), { ...replied, openFile: "Offer_Grant_Olivia.pdf" }, signals()),
+    ).toBe(at("open-letter"));
+  });
+
+  it("ends on the closing card", () => {
+    const all = signals(
+      "started",
+      "feedback-expanded",
+      "thumbs-down-open",
+      "feedback-down-saved",
+      "run-started",
+      "run-finished",
+      "versions-open",
+    );
+    expect(settledStep(at("batch"), { ...idle, page: "hone" }, all)).toBe(at("done"));
+  });
+});
+
+describe("guide text", () => {
+  const languages = Object.entries(GUIDE_STRINGS);
+
+  it.each(languages)("has a card for every step in %s", (_language, strings) => {
+    for (const step of GUIDE_STEPS) expect(strings.steps[step.id].title).not.toBe("");
+  });
+
+  it.each(languages)(
+    "keeps %s sentences free of colons, semicolons and dashes",
+    (_language, strings) => {
+      const cards = [...Object.values(strings.steps), strings.watchLong, strings.startAgain];
+      const text = cards.flatMap((card) => [card.title, card.body, card.next ?? ""]);
+      for (const line of text) expect(line).not.toMatch(/[:;\u2013\u2014]/);
+    },
+  );
+});
+
+describe("parseHoneFrameData", () => {
+  it("reads Hone's messages and drops anything else", () => {
+    expect(
+      parseHoneFrameData({ source: "hone", type: "run-started", runId: "r_1", quick: true }),
+    ).toEqual({
+      type: "run-started",
+      runId: "r_1",
+      quick: true,
+    });
+    expect(parseHoneFrameData({ source: "hone", type: "route", path: "/versions" })).toEqual({
+      type: "route",
+      path: "/versions",
+    });
+    expect(parseHoneFrameData({ source: "other", type: "activity" })).toBeNull();
+    expect(parseHoneFrameData({ source: "hone", type: "run-started" })).toBeNull();
+    expect(parseHoneFrameData("hone")).toBeNull();
+  });
+});
