@@ -0,0 +1,106 @@
+import { create } from "zustand";
+import { createJSONStorage, persist } from "zustand/middleware";
+
+import { resolveStorage } from "~/lib/storage";
+import { GUIDE_STEPS, type GuideSignal } from "./guideSteps";
+import { guideText } from "./guideText";
+
+interface GuideState {
+  /** Guide mode is on. It stays on through reloads until the presenter exits it. */
+  readonly on: boolean;
+  readonly step: number;
+  readonly signals: ReadonlyArray<GuideSignal>;
+  /** Set by Back, so the guide waits on that step until something changes. */
+  readonly heldAt: string | null;
+  /** The scoped key of the chat the visitor started, once it exists. */
+  readonly visitorChat: string | null;
+  /** Whether the visitor's optimization replays a recording, null until it starts. */
+  readonly runQuick: boolean | null;
+  /** The visitor's last optimization stopped with an error. */
+  readonly runFailed: boolean;
+  /** The presenter is entering the exit PIN, so the guide steps aside. Not kept over reloads. */
+  readonly unlocking: boolean;
+  readonly setUnlocking: (unlocking: boolean) => void;
+  readonly enter: () => void;
+  readonly exit: () => void;
+  /** Back to the welcome card with a fresh visit. */
+  readonly restart: () => void;
+  readonly goTo: (step: number, heldAt?: string | null) => void;
+  readonly signal: (signal: GuideSignal) => void;
+  readonly setVisitorChat: (key: string) => void;
+  readonly setRunQuick: (quick: boolean) => void;
+  /** A failed run sends the visitor back to Start optimization. */
+  readonly failRun: () => void;
+}
+
+const freshVisit = {
+  step: 0,
+  signals: [],
+  heldAt: null,
+  visitorChat: null,
+  runQuick: null,
+  runFailed: false,
+} as const;
+
+export const useGuideStore = create<GuideState>()(
+  persist(
+    (set) => ({
+      on: false,
+      unlocking: false,
+      ...freshVisit,
+      enter: () => set({ on: true, ...freshVisit }),
+      exit: () => set({ on: false, unlocking: false, ...freshVisit }),
+      setUnlocking: (unlocking) => set({ unlocking }),
+      restart: () => set(freshVisit),
+      goTo: (step, heldAt = null) =>
+        set({ step: Math.max(0, Math.min(step, GUIDE_STEPS.length - 1)), heldAt }),
+      signal: (signal) =>
+        set((state) =>
+          state.on && !state.signals.includes(signal)
+            ? { signals: [...state.signals, signal] }
+            : state,
+        ),
+      setVisitorChat: (visitorChat) => set({ visitorChat }),
+      setRunQuick: (runQuick) => set({ runQuick, runFailed: false }),
+      failRun: () =>
+        set((state) => ({
+          runFailed: true,
+          runQuick: null,
+          signals: state.signals.filter((signal) => signal !== "run-started"),
+          step: Math.min(
+            state.step,
+            GUIDE_STEPS.findIndex((step) => step.id === "start"),
+          ),
+          heldAt: null,
+        })),
+    }),
+    {
+      name: "t3code:hone-guide:v1",
+      version: 1,
+      storage: createJSONStorage(() =>
+        resolveStorage(typeof window !== "undefined" ? window.localStorage : undefined),
+      ),
+      partialize: ({ on, step, signals, heldAt, visitorChat, runQuick, runFailed }) => ({
+        on,
+        step,
+        signals,
+        heldAt,
+        visitorChat,
+        runQuick,
+        runFailed,
+      }),
+    },
+  ),
+);
+
+/** Records an event the guide may be waiting for. Does nothing outside guide mode. */
+export function guideSignal(signal: GuideSignal): void {
+  useGuideStore.getState().signal(signal);
+}
+
+/** The feedback the guide writes for the visitor, while it asks for a thumbs down. */
+export function guideFeedbackDraft(): string | null {
+  const { on, step } = useGuideStore.getState();
+  const id = GUIDE_STEPS[step]?.id;
+  return on && (id === "thumbs-down" || id === "send-feedback") ? guideText.feedback : null;
+}
