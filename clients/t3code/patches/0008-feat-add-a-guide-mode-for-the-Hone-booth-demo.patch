+// The booth guide's scenario. Each step names what the visitor uses and the real event that ends it.
+
+export type GuideStepId =
+  | "welcome"
+  | "open-past-chat"
+  | "read-feedback"
+  | "new-chat"
+  | "send"
+  | "working"
+  | "open-letter"
+  | "thumbs-down"
+  | "send-feedback"
+  | "batch"
+  | "start"
+  | "watch"
+  | "versions"
+  | "done";
+
+/** Events that happened during this visit. They stay set until the guide starts over. */
+export type GuideSignal =
+  | "started"
+  | "feedback-expanded"
+  | "thumbs-down-open"
+  | "feedback-down-saved"
+  | "run-started"
+  | "run-finished"
+  | "versions-open";
+
+/** What the screen shows right now. */
+export interface GuideFacts {
+  readonly page: "home" | "thread" | "draft" | "hone" | "other";
+  /** The chat the visitor started in this visit, once it exists. */
+  readonly visitorChat: {
+    readonly sent: boolean;
+    readonly replied: boolean;
+    readonly running: boolean;
+  } | null;
+  readonly onVisitorChat: boolean;
+  /** The file open in the right panel of the shown chat, relative to the project. */
+  readonly openFile: string | null;
+}
+
+/** An element in t3code to spotlight, or a control in the Hone frame to outline. */
+export type GuideTarget =
+  | { readonly kind: "page"; readonly selector: string; readonly text?: string }
+  | { readonly kind: "frame"; readonly highlight: string };
+
+export interface GuideStep {
+  readonly id: GuideStepId;
+  readonly target: GuideTarget | null;
+  readonly done: (facts: GuideFacts, signals: ReadonlySet<GuideSignal>) => boolean;
+  /** Idle time does not count while this holds. A visitor watching work is not idle. */
+  readonly busy?: (facts: GuideFacts, signals: ReadonlySet<GuideSignal>) => boolean;
+}
+
+/** The letter the visitor's chat writes. */
+const OUTPUT_LETTER = /^Offer_Osei[^/]*\.(pdf|docx)$/;
+
+export const GUIDE_STEPS: ReadonlyArray<GuideStep> = [
+  { id: "welcome", target: null, done: (_f, s) => s.has("started") },
+  {
+    id: "open-past-chat",
+    target: {
+      kind: "page",
+      selector: '[role="treeitem"][aria-label^="Offer letter for Olivia Grant"]',
+    },
+    done: (f) => f.page === "thread" && !f.onVisitorChat,
+  },
+  {
+    id: "read-feedback",
+    target: { kind: "page", selector: '[data-guide="hone-feedback"]' },
+    done: (_f, s) => s.has("feedback-expanded"),
+  },
+  {
+    id: "new-chat",
+    target: { kind: "page", selector: 'button[aria-label="New thread"]' },
+    done: (f) => f.page === "draft" || f.visitorChat !== null,
+  },
+  {
+    id: "send",
+    target: { kind: "page", selector: 'form button[type="submit"][aria-label="Submit message"]' },
+    done: (f) => f.visitorChat?.sent === true,
+  },
+  {
+    id: "working",
+    target: null,
+    done: (f) => f.visitorChat?.replied === true && !f.visitorChat.running,
+    busy: (f) => f.visitorChat?.running === true,
+  },
+  {
+    id: "open-letter",
+    target: { kind: "page", selector: '[data-item-path="Offer_Osei_Amara.pdf"]' },
+    done: (f) => f.openFile !== null && OUTPUT_LETTER.test(f.openFile),
+  },
+  {
+    id: "thumbs-down",
+    target: { kind: "page", selector: '[data-guide="thumbs-down"]' },
+    done: (_f, s) => s.has("thumbs-down-open") || s.has("feedback-down-saved"),
+  },
+  {
+    id: "send-feedback",
+    target: { kind: "page", selector: '[data-guide="send-feedback"]' },
+    done: (_f, s) => s.has("feedback-down-saved"),
+  },
+  {
+    id: "batch",
+    target: { kind: "page", selector: '[data-guide="hone-chip"]' },
+    done: (f) => f.page === "hone",
+  },
+  {
+    id: "start",
+    target: { kind: "frame", highlight: "start" },
+    done: (_f, s) => s.has("run-started"),
+  },
+  {
+    id: "watch",
+    target: { kind: "frame", highlight: "judge" },
+    done: (_f, s) => s.has("run-finished"),
+    busy: (_f, s) => s.has("run-started") && !s.has("run-finished"),
+  },
+  {
+    id: "versions",
+    target: { kind: "frame", highlight: "nav/versions" },
+    done: (_f, s) => s.has("versions-open"),
+  },
+  { id: "done", target: null, done: () => false },
+];
+
+/** The furthest step the visitor has reached, moving on past every step that is already done. */
+export function settledStep(
+  index: number,
+  facts: GuideFacts,
+  signals: ReadonlySet<GuideSignal>,
+): number {
+  let at = Math.max(0, Math.min(index, GUIDE_STEPS.length - 1));
+  while (at < GUIDE_STEPS.length - 1 && GUIDE_STEPS[at]!.done(facts, signals)) at += 1;
+  return at;
+}
+
+/** A key that changes whenever anything a step could wait for changes. */
+export function guideFactsKey(facts: GuideFacts, signals: ReadonlySet<GuideSignal>): string {
+  return JSON.stringify([facts, [...signals].toSorted()]);
+}
