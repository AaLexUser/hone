new file mode 100644
index 00000000..dd62a1ba
--- /dev/null
+++ b/apps/web/src/components/hone/guide/useGuideStartOver.ts
@@ -0,0 +1,31 @@
+import type { EnvironmentId } from "@t3tools/contracts";
+
+import { requestConfirmDialog } from "~/confirmDialog";
+import { useHoneDemoReset } from "../../chat/HoneControls";
+import { useGuideStore } from "./guideStore";
+import { guideText } from "./guideText";
+
+/**
+ * Resets the demo the way the sidebar's Reset demo does, then shows the welcome card. A visitor
+ * confirms first. The idle reset and the closing card do not ask.
+ */
+export function useGuideStartOver(environmentId: EnvironmentId | null) {
+  const resetDemo = useHoneDemoReset(environmentId);
+  return async ({ confirm }: { readonly confirm: boolean }) => {
+    const store = useGuideStore.getState();
+    if (store.confirming || store.resetting) return;
+    if (confirm) {
+      store.setConfirming(true);
+      const confirmed = await requestConfirmDialog(guideText.startOverConfirm, {
+        variant: "destructive",
+      });
+      useGuideStore.getState().setConfirming(false);
+      if (confirmed !== true) return;
+    }
+    useGuideStore.getState().setResetting(true);
+    const reset = await resetDemo({ confirm: false });
+    const after = useGuideStore.getState();
+    after.setResetting(false);
+    if (reset) after.restart();
+  };
+}
