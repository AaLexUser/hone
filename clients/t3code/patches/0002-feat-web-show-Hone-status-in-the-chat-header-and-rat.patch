diff --git a/apps/web/src/state/hone.ts b/apps/web/src/state/hone.ts
new file mode 100644
index 00000000..83aeb968
--- /dev/null
+++ b/apps/web/src/state/hone.ts
@@ -0,0 +1,68 @@
+import { useAtomValue } from "@effect/atom-react";
+import { scopeThreadRef } from "@t3tools/client-runtime/environment";
+import {
+  createEnvironmentRpcCommand,
+  createEnvironmentRpcQueryAtomFamily,
+} from "@t3tools/client-runtime/state/runtime";
+import { type EnvironmentId, type ThreadId, type TurnItemId, WS_METHODS } from "@t3tools/contracts";
+import { Atom } from "effect/reactivity";
+
+import { connectionAtomRuntime } from "../connection/runtime";
+import { environmentThreadDetails } from "./threads";
+
+export const honeEnvironment = {
+  status: createEnvironmentRpcQueryAtomFamily(connectionAtomRuntime, {
+    label: "environment-data:hone:status",
+    tag: WS_METHODS.honeStatus,
+    staleTimeMs: 0,
+    refreshIntervalMs: 4_000,
+  }),
+  feedback: createEnvironmentRpcCommand(connectionAtomRuntime, {
+    label: "environment-data:hone:feedback",
+    tag: WS_METHODS.honeFeedback,
+  }),
+};
+
+/** A Pi reply Hone can take feedback on, and whether it is the thread's newest reply. */
+export type HoneReply = "latest" | "earlier" | null;
+
+const honeReplyAtom = Atom.family((key: string) => {
+  const { environmentId, threadId, itemId } = JSON.parse(key) as {
+    readonly environmentId: EnvironmentId;
+    readonly threadId: ThreadId;
+    readonly itemId: TurnItemId;
+  };
+  const ref = scopeThreadRef(environmentId, threadId);
+  return Atom.make((get): HoneReply => {
+    const projection = get(environmentThreadDetails.threadAtom(ref))?.projection;
+    const item = projection?.turnItems.find((candidate) => candidate.id === itemId);
+    if (projection === undefined || item?.type !== "assistant_message") return null;
+    const providerThread = projection.providerThreads.find(
+      (candidate) => candidate.id === item.providerThreadId,
+    );
+    if (providerThread?.driver !== "pi") return null;
+    const latest = projection.turnItems.findLast(
+      (candidate) => candidate.type === "assistant_message",
+    );
+    return latest?.id === itemId ? "latest" : "earlier";
+  }).pipe(Atom.withLabel(`web-hone-reply:${key}`));
+});
+
+const NO_HONE_REPLY = Atom.make<HoneReply>(null);
+
+export function useHoneReply(
+  environmentId: EnvironmentId,
+  item: { readonly sourceThreadId: ThreadId; readonly sourceItemId: TurnItemId } | undefined,
+): HoneReply {
+  return useAtomValue(
+    item === undefined
+      ? NO_HONE_REPLY
+      : honeReplyAtom(
+          JSON.stringify({
+            environmentId,
+            threadId: item.sourceThreadId,
+            itemId: item.sourceItemId,
+          }),
+        ),
+  );
+}
