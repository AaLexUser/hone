+import {
+  isAtomCommandInterrupted,
+  squashAtomCommandFailure,
+} from "@t3tools/client-runtime/state/runtime";
+import type { EnvironmentId, HoneFeedbackRating, HoneStatus, ThreadId } from "@t3tools/contracts";
+import { ThumbsDownIcon, ThumbsUpIcon } from "lucide-react";
+import { useEffect, useRef, useState } from "react";
+
+import { cn } from "~/lib/utils";
+import { honeEnvironment } from "~/state/hone";
+import { useEnvironmentQuery } from "~/state/query";
+import { useAtomCommand } from "~/state/use-atom-command";
+import { ConnectionStatusDot } from "../ConnectionStatusDot";
+import { Button } from "../ui/button";
+import { Popover, PopoverPopup, PopoverTitle, PopoverTrigger } from "../ui/popover";
+import { Textarea } from "../ui/textarea";
+import { toastManager } from "../ui/toast";
+import { Tooltip, TooltipPopup, TooltipTrigger } from "../ui/tooltip";
+
+/** Which AGENTS.md the agent runs and how close Hone is to rewriting it. */
+export function HoneStatusChip({ environmentId }: { readonly environmentId: EnvironmentId }) {
+  const status = useEnvironmentQuery(honeEnvironment.status({ environmentId, input: {} })).data;
+  useHoneUpdateToasts(status);
+  if (status === null || status.dashboardUrl === null) return null;
+  const optimizing = status.reachable && status.run !== null;
+  return (
+    <Tooltip>
+      <TooltipTrigger
+        render={
+          <a
+            href={status.dashboardUrl}
+            target="_blank"
+            rel="noreferrer"
+            aria-label="Open the Hone dashboard"
+            className="flex shrink-0 items-center gap-1.5 rounded-md px-1.5 py-0.5 text-muted-foreground text-xs transition-colors hover:bg-accent hover:text-foreground"
+          />
+        }
+      >
+        <ConnectionStatusDot
+          dotClassName={
+            !status.reachable ? "bg-destructive" : optimizing ? "bg-warning" : "bg-success"
+          }
+          pingClassName={optimizing ? "bg-warning/60 duration-2000" : null}
+        />
+        <span className="font-medium text-foreground">Hone</span>
+        {status.reachable ? (
+          <>
+            <span>
+              AGENTS.md <span className="font-mono">{status.versionId ?? "none"}</span>
+            </span>
+            <span className="tabular-nums">
+              batch {status.pendingCount}/{status.batchSize}
+            </span>
+            {optimizing ? <span className="text-warning">optimizing…</span> : null}
+          </>
+        ) : (
+          <span>offline</span>
+        )}
+      </TooltipTrigger>
+      <TooltipPopup side="bottom" className="max-w-72">
+        {status.reachable ? (
+          <div className="flex flex-col gap-1">
+            {status.versionTitle ? <span>{status.versionTitle}</span> : null}
+            <span className="text-muted-foreground">
+              {status.pendingCount} of {status.batchSize} sessions collected for the next AGENTS.md
+              optimization.
+            </span>
+          </div>
+        ) : (
+          <span>Hone is not reachable.</span>
+        )}
+      </TooltipPopup>
+    </Tooltip>
+  );
+}
+
+function useHoneUpdateToasts(status: HoneStatus | null) {
+  const previous = useRef<HoneStatus | null>(null);
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- raises imperative toasts when a poll shows a new session or AGENTS.md version
+  useEffect(() => {
+    if (status === null || !status.reachable) return;
+    const before = previous.current;
+    previous.current = status;
+    if (before === null) return;
+    if (status.traceCount > before.traceCount) {
+      toastManager.add({
+        type: "info",
+        title: "Session sent to Hone",
+        description: `${status.pendingCount} of ${status.batchSize} sessions toward the next AGENTS.md update.`,
+      });
+    }
+    if (status.versionId !== null && status.versionId !== before.versionId) {
+      toastManager.add({
+        type: "success",
+        title: `AGENTS.md updated · ${status.versionId}`,
+        ...(status.versionTitle ? { description: status.versionTitle } : {}),
+      });
+    }
+  }, [status]);
+}
+
+const RATINGS = [
+  {
+    rating: "up",
+    Icon: ThumbsUpIcon,
+    label: "Good reply, tell Hone",
+    prompt: "What did you like?",
+  },
+  {
+    rating: "down",
+    Icon: ThumbsDownIcon,
+    label: "Needs work, tell Hone",
+    prompt: "What should the agent do differently next time?",
+  },
+] as const;
+
+/** Rates a Pi reply; Hone reads the rating and comment when it next rewrites AGENTS.md. */
+export function HoneFeedbackControl({
+  environmentId,
+  threadId,
+}: {
+  readonly environmentId: EnvironmentId;
+  readonly threadId: ThreadId;
+}) {
+  const sendFeedback = useAtomCommand(honeEnvironment.feedback, { reportFailure: false });
+  const [openRating, setOpenRating] = useState<HoneFeedbackRating | null>(null);
+  const [sentRating, setSentRating] = useState<HoneFeedbackRating | null>(null);
+  const [comment, setComment] = useState("");
+  const [sending, setSending] = useState(false);
+
+  const submit = async (rating: HoneFeedbackRating) => {
+    setSending(true);
+    const result = await sendFeedback({
+      environmentId,
+      input: { threadId, rating, comment: comment.trim() },
+    });
+    setSending(false);
+    if (result._tag === "Success") {
+      setSentRating(rating);
+      setOpenRating(null);
+      toastManager.add({
+        type: "success",
+        title: `Feedback sent to Hone (${result.value.traceId})`,
+      });
+      return;
+    }
+    if (isAtomCommandInterrupted(result)) return;
+    const error = squashAtomCommandFailure(result);
+    toastManager.add({
+      type: "error",
+      title: "Could not send feedback to Hone",
+      description: error instanceof Error ? error.message : "An error occurred.",
+    });
+  };
+
+  return (
+    <div className="flex items-center">
+      {RATINGS.map(({ rating, Icon, label, prompt }) => (
+        <Popover
+          key={rating}
+          open={openRating === rating}
+          onOpenChange={(open) => {
+            if (open) setComment("");
+            setOpenRating(open ? rating : null);
+          }}
+        >
+          <PopoverTrigger
+            render={
+              <Button
+                type="button"
+                size="icon-xs"
+                variant={sentRating === rating ? "secondary" : "ghost"}
+                aria-label={label}
+                aria-pressed={sentRating === rating}
+              />
+            }
+          >
+            <Icon className={cn("size-3", sentRating === rating && "fill-current")} />
+          </PopoverTrigger>
+          <PopoverPopup side="top" align="start" width="md" padding="compact">
+            <form
+              className="flex flex-col gap-2"
+              onSubmit={(event) => {
+                event.preventDefault();
+                void submit(rating);
+              }}
+            >
+              <PopoverTitle>{prompt}</PopoverTitle>
+              <Textarea
+                autoFocus
+                rows={3}
+                value={comment}
+                placeholder="Hone uses this to improve AGENTS.md"
+                onChange={(event) => setComment(event.target.value)}
+                onKeyDown={(event) => {
+                  if (event.key === "Enter" && (event.metaKey || event.ctrlKey)) {
+                    event.preventDefault();
+                    void submit(rating);
+                  }
+                }}
+              />
+              <div className="flex justify-end">
+                <Button type="submit" size="xs" disabled={sending}>
+                  Send to Hone
+                </Button>
+              </div>
+            </form>
+          </PopoverPopup>
+        </Popover>
+      ))}
+    </div>
+  );
+}
