{$SITE_ADDRESS} {
	# CPA uses its own API and management keys, including the panel's root API paths.
	@booth not path /cpa /cpa/* /v8/management /v8/management/* /v0/management /v0/management/* /v0/resource/plugins/* /v1/models
	basic_auth @booth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	redir /cpa /cpa/ 308
	handle_path /cpa/* {
		reverse_proxy cpa:8317 {
			flush_interval -1
		}
	}

	# The official panel detects the origin as its API base, without /cpa.
	@cpaManagement path /v8/management /v8/management/* /v0/management /v0/management/* /v0/resource/plugins/* /v1/models
	handle @cpaManagement {
		reverse_proxy cpa:8317 {
			flush_interval -1
		}
	}

	# /hone without a slash stays with t3code, which shows Hone in a frame there.
	# Hone's write token is added here, so it never reaches the browser.
	handle_path /hone/* {
		reverse_proxy hone:8080 {
			header_up Authorization "Bearer {$HONE_TOKEN}"
		}
	}

	# The booth video for guide mode, from ./booth-video next to the compose file.
	handle_path /booth-video/* {
		root * /srv/booth-video
		file_server
	}

	# The booth loop with a player, for showing it on demand. It plays /booth-video/loop.mp4.
	@loop path /loop /loop/
	handle @loop {
		root * /srv/booth-player
		rewrite * /index.html
		file_server
	}

	# t3code signs in every request that carries the shared secret.
	handle {
		reverse_proxy t3code:3773 {
			header_up -Authorization
			header_up X-T3code-Proxy-Auth {$T3CODE_PROXY_AUTH_SECRET}
		}
	}
}
