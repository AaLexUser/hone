# Copy this file to deploy/.env and fill in every value. Never commit .env.

# The address Caddy serves. A domain such as demo.example.com gets automatic HTTPS
# and needs ports 80 and 443 open. Use :80 for plain HTTP on this machine.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# The one login everyone at the booth shares.
# Make the hash with the command below. It asks for the password.
#   docker run --rm -it caddy:2.11 caddy hash-password
# Keep the single quotes around the hash, because it contains $ signs.
BASIC_AUTH_USER=booth
BASIC_AUTH_HASH='$2a$14$replace.with.the.output.of.caddy.hash-password'

# A long random string that Caddy sends to t3code on every request. Make it with
#   openssl rand -hex 32
T3CODE_PROXY_AUTH_SECRET=

# Hone's write token, shared by Caddy, t3code and Hone. Make it with
#   openssl rand -hex 24
HONE_TOKEN=

# The OpenCode Go key. The Pi agent uses it for deepseek-v4.1-flash, and every
# seat of a real optimization uses it for the models in hone.yaml.
OPENCODE_API_KEY=

# The day the demo's prepared state is built for. Recorded runs replay only on
# the same prepared state, so keep the booth day unless you record new runs.
HONE_DEMO_DATE=2026-11-11

# Guide mode. The PIN is asked when the presenter leaves guide mode. Leave it empty
# for a two second hold only. The booth video plays after the first idle time, and
# the demo starts over after the second, both in seconds. Put the loop MP4 at
# deploy/booth-video/loop.mp4, which git ignores.
HONE_GUIDE_PIN=
HONE_GUIDE_IDLE_VIDEO_SECONDS=90
HONE_GUIDE_IDLE_RESET_SECONDS=300

# Set to 1 to record the first turn of each new chat for the turn cache.
HONE_TURN_CACHE_RECORD=0
