# Copy this file to deploy/.env and fill in every value. Never commit .env.

# The address Caddy serves. A domain such as demo.example.com gets automatic HTTPS
# and needs ports 80 and 443 open. Use :80 for plain HTTP on this machine.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# The one login everyone at the booth shares.
# Make the hash with the command below. It asks for the password.
#   docker run --rm -it caddy:2.11 caddy hash-password
# Keep the single quotes around the hash, because it contains $ signs.
BASIC_AUTH_USER=booth
BASIC_AUTH_HASH='$2a$14$replace.with.the.output.of.caddy.hash-password'

# A long random string that Caddy sends to t3code on every request. Make it with
#   openssl rand -hex 32
T3CODE_PROXY_AUTH_SECRET=

# Hone's write token, shared by Caddy, t3code and Hone. Make it with
#   openssl rand -hex 24
HONE_TOKEN=

# The OpenCode key Pi uses to reach its model (opencode-go, deepseek-v4.1-flash).
OPENCODE_API_KEY=
